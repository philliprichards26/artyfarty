ted2)}\n.star-btn.on{color:var(--amber)}\n.vbadge{font-size:11px;font-weight:600;color:var(--muted);background:var(--surface);border:1px solid var(--border);padding:2px 6px;border-radius:6px}\n.card-detail{display:none;border-top:1.5px solid var(--border);background:var(--surface)}\n.card-detail.open{display:block}\n.vlist{padding:8px 14px}\n.vrow{display:flex;align-items:center;gap:8px;padding:9px 0;border-bottom:1px solid var(--border)}\n.vrow:last-child{border-bottom:none}\n.vtag{font-size:12px;font-weight:700;padding:4px 9px;border-radius:7px;background:var(--bg);border:1px solid var(--border);flex-shrink:0;min-width:34px;text-align:center}\n.vtag.pref{background:var(--amber);color:#000;border-color:var(--amber)}\n.vnote{flex:1;font-size:13px;color:var(--muted);font-style:italic;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.vstar{background:none;border:none;font-size:18px;color:var(--muted2);cursor:pointer;padding:4px;flex-shrink:0}\n.vstar.on{color:var(--amber)}\n.vdl{background:none;border:1px solid var(--border);border-radius:7px;padding:5px 10px;font-size:12px;color:var(--muted);cursor:pointer;flex-shrink:0}\n.card-actions{display:flex;gap:8px;padding:10px 14px 14px;flex-wrap:wrap}\n.act-btn{flex:1;min-width:70px;padding:10px 8px;border-radius:10px;border:1.5px solid var(--border);background:var(--bg);font-size:13px;font-weight:500;color:var(--muted);cursor:pointer;text-align:center}\n.act-btn.danger{color:var(--red);border-color:#fca5a5}\n.bottom-nav{display:flex;background:var(--surface);border-top:1px solid var(--border);flex-shrink:0}\n.nav-btn{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:10px 4px;background:none;border:none;cursor:pointer;color:var(--muted2);gap:3px}\n.nav-btn.active{color:var(--amber)}\n.nav-icon{font-size:22px;line-height:1}\n.nav-label{font-size:10px;font-weight:600}\n.fab{position:fixed;bottom:74px;right:20px;width:56px;height:56px;border-radius:50%;background:var(--amber);border:none;font-size:28px;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 4px 16px rgba(240,165,0,.4);z-index:50}\n.overlay{position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:98;opacity:0;pointer-events:none;transition:opacity .25s}\n.overlay.show{opacity:1;pointer-events:all}\n.sheet{position:fixed;bottom:0;left:50%;transform:translateX(-50%) translateY(100%);width:100%;max-width:480px;background:var(--surface);border-radius:20px 20px 0 0;z-index:99;transition:transform .3s cubic-bezier(.4,0,.2,1);max-height:88vh;display:flex;flex-direction:column}\n.sheet.show{transform:translateX(-50%) translateY(0)}\n.handle{width:36px;height:4px;background:var(--border);border-radius:2px;margin:10px auto 4px;flex-shrink:0}\n.sheet-hdr{padding:8px 20px 14px;border-bottom:1px solid var(--border);display:flex;align-items:center;flex-shrink:0}\n.sheet-title{font-size:17px;font-weight:700;flex:1}\n.sheet-close{background:var(--bg);border:1px solid var(--border);border-radius:50%;width:30px;height:30px;display:flex;align-items:center;justify-content:center;font-size:14px;cursor:pointer;color:var(--muted)}\n.sheet-body{flex:1;overflow-y:auto;padding:16px 20px}\n.fg{margin-bottom:14px}\n.fl{font-size:12px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.6px;margin-bottom:5px;display:block}\n.fi{width:100%;padding:13px 14px;border:1.5px solid var(--border);border-radius:10px;font-size:15px;color:var(--text);background:var(--bg);outline:none;font-family:inherit}\n.fi:focus{border-color:var(--amber);background:var(--surface)}\n.fi::placeholder{color:var(--muted2)}\ntextarea.fi{min-height:80px;resize:vertical;line-height:1.5}\nselect.fi{cursor:pointer}\n.frow{display:flex;gap:10px}\n.frow .fg{flex:1}\n.tags-wrap{display:flex;gap:5px;flex-wrap:wrap;margin-top:6px}\n.tag-chip{display:flex;align-items:center;gap:4px;padding:4px 10px;border-radius:20px;background:var(--amber-lt);font-size:12px;font-weight:500;color:#92400e}\n.tag-chip button{background:none;border:none;cursor:pointer;font-size:13px;color:#92400e;padding:0;line-height:1}\n.pref-row{display:flex;align-items:center;gap:10px;padding:12px 14px;background:var(--bg);border:1.5px solid var(--border);border-radius:10px;cursor:pointer;font-size:14px;font-weight:500;margin-bottom:14px}\n.tswitch{width:44px;height:26px;background:var(--border);border-radius:13px;margin-left:auto;position:relative;transition:background .2s;flex-shrink:0}\n.tswitch::after{content:'';position:absolute;width:20px;height:20px;background:#fff;border-radius:50%;top:3px;left:3px;transition:transform .2s;box-shadow:0 1px 4px rgba(0,0,0,.2)}\n.tswitch.on{background:var(--amber)}\n.tswitch.on::after{transform:translateX(18px)}\n.sub-btn{width:100%;padding:15px;background:var(--amber);border:none;border-radius:12px;font-size:16px;font-weight:700;color:#000;cursor:pointer;margin-top:4px}\n.folder-grid{padding:16px;display:grid;grid-template-columns:1fr 1fr;gap:10px}\n.fcard{background:var(--bg);border:1.5px solid var(--border);border-radius:var(--radius);padding:16px 14px;cursor:pointer;display:flex;flex-direction:column;gap:6px}\n.fcard-icon{font-size:28px}\n.fcard-name{font-size:14px;font-weight:600}\n.fcard-count{font-size:12px;color:var(--muted)}\n.fcard.add{border-style:dashed;align-items:center;justify-content:center;color:var(--muted);font-size:13px;font-weight:500;flex-direction:row;gap:6px}\n.stats-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:16px}\n.scard{background:var(--bg);border:1.5px solid var(--border);border-radius:var(--radius);padding:16px;text-align:center}\n.snum{font-size:32px;font-weight:700}\n.slabel{font-size:12px;color:var(--muted);margin-top:3px}\n.exp-sec{padding:0 16px 16px;display:flex;flex-direction:column;gap:8px}\n.exp-btn{padding:14px;border-radius:12px;border:1.5px solid var(--border);background:var(--bg);font-size:15px;font-weight:500;color:var(--text);cursor:pointer;text-align:left;display:flex;align-items:center;gap:10px;font-family:inherit}\n.exp-btn.danger{color:var(--red);border-color:#fca5a5}\n.toast{position:fixed;bottom:82px;left:50%;transform:translateX(-50%) translateY(20px);background:#1f2937;color:#fff;padding:10px 20px;border-radius:24px;font-size:14px;font-weight:500;opacity:0;transition:all .3s cubic-bezier(.34,1.56,.64,1);z-index:999;white-space:nowrap;pointer-events:none}\n.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}\n.icon-grid{display:flex;gap:8px;flex-wrap:wrap;margin-top:6px}\n.icon-opt{font-size:28px;background:none;border:2px solid transparent;border-radius:8px;padding:4px;cursor:pointer}\n.icon-opt.sel{border-color:var(--amber)}\n.privacy-box{font-size:13px;color:var(--muted);line-height:1.6;background:var(--bg);border:1.5px solid var(--border);border-radius:12px;padding:14px;margin-bottom:8px}\n\n.rebuild-box{background:#f0fdf4;border:1.5px solid #bbf7d0;border-radius:10px;padding:10px 12px;margin:0 14px 10px;font-size:12px;color:#166534;display:none}\n.rebuild-box.show{display:block}\n.rebuild-prompt{font-family:monospace;font-size:11px;background:#dcfce7;border-radius:6px;padding:8px;margin:6px 0;line-height:1.5;word-break:break-word}\n.copy-prompt-btn{padding:8px 14px;background:#16a34a;border:none;border-radius:7px;color:#fff;font-size:12px;font-weight:600;cursor:pointer;width:100%;margin-top:4px}\n.attach-indicator{font-size:11px;font-weight:500;margin-top:2px}\n.attach-ok{color:#16a34a}\n.attach-no{color:var(--muted2)}\n</style>\n</head>\n<body>\n<div class=\"app\">\n  <div class=\"header\">\n    <div class=\"header-top\">\n      <div class=\"logo\">⬡</div>\n      <div class=\"header-title\">Artifact<span>Manager</span></div>\n      <div class=\"icon-btn\" onclick=\"openSheet('shareSheet')\">📋</div>\n    </div>\n    <div class=\"search-bar\">\n      <span style=\"font-size:16px;color:var(--muted2)\">🔍</span>\n      <input type=\"search\" placeholder=\"Search artifacts…\" id=\"searchInput\" oninput=\"onSearch(this.value)\">\n    </div>\n  </div>\n\n  <div class=\"filter-row\">\n    <button class=\"pill active\" onclick=\"setFilter('all',this)\">All</button>\n    <button class=\"pill\" onclick=\"setFilter('starred',this)\">⭐ Starred</button>\n    <button class=\"pill\" onclick=\"setFilter('html',this)\">🌐 HTML</button>\n    <button class=\"pill\" onclick=\"setFilter('py',this)\">🐍 Python</button>\n    <button class=\"pill\" onclick=\"setFilter('xlsx',this)\">📊 Excel</button>\n    <button class=\"pill\" onclick=\"setFilter('docx',this)\">📝 Word</button>\n    <button class=\"pill\" onclick=\"setFilter('sql',this)\">🗄 SQL</button>\n    <button class=\"pill\" onclick=\"setFilter('md',this)\">📋 MD</button>\n  </div>\n\n  <div class=\"content\" id=\"content\"></div>\n\n  <button class=\"fab\" id=\"fab\" onclick=\"openSheet('saveSheet')\">+</button>\n\n  <div class=\"bottom-nav\">\n    <button class=\"nav-btn active\" id=\"nav-home\" onclick=\"switchTab('home')\">\n      <span class=\"nav-icon\">📦</span><span class=\"nav-label\">Artifacts</span>\n    </button>\n    <button class=\"nav-btn\" id=\"nav-folders\" onclick=\"switchTab('folders')\">\n      <span class=\"nav-icon\">📁</span><span class=\"nav-label\">Folders</span>\n    </button>\n    <button class=\"nav-btn\" id=\"nav-settings\" onclick=\"switchTab('settings')\">\n      <span class=\"nav-icon\">⚙️</span><span class=\"nav-label\">Settings</span>\n    </button>\n  </div>\n</div>\n\n<div class=\"overlay\" id=\"overlay\" onclick=\"closeSheets()\"></div>\n\n<div class=\"sheet\" id=\"saveSheet\">\n  <div class=\"handle\"></div>\n  <div class=\"sheet-hdr\">\n    <div class=\"sheet-title\" id=\"saveTitle\">Save Artifact</div>\n    <div class=\"sheet-close\" onclick=\"closeSheets()\">✕</div>\n  </div>\n  <div class=\"sheet-body\">\n    <input type=\"hidden\" id=\"editId\">\n    <div class=\"fg\"><label class=\"fl\">Name *</label><input class=\"fi\" id=\"artName\" placeholder=\"e.g. dashboard.html\"></div>\n    <div class=\"fg\"><label class=\"fl\">Description</label><input class=\"fi\" id=\"artDesc\" placeholder=\"What does it do?\"></div>\n    <div class=\"frow\">\n      <div class=\"fg\"><label class=\"fl\">Version</label><input class=\"fi\" id=\"artVer\" placeholder=\"v1\"></div>\n      <div class=\"fg\"><label class=\"fl\">Folder</label><select class=\"fi\" id=\"artFolder\"><option value=\"\">None</option></select></div>\n    </div>\n    <div class=\"fg\"><label class=\"fl\">Version Note</label><input class=\"fi\" id=\"artNote\" placeholder=\"e.g. best layout so far\"></div>\n    <div class=\"fg\">\n      <label class=\"fl\">Tags (press Enter)</label>\n      <input class=\"fi\" id=\"tagInput\" placeholder=\"Add tag…\" onkeydown=\"if(event.key==='Enter'){event.preventDefault();addTag()}\">\n      <div class=\"tags-wrap\" id=\"tagsWrap\"></div>\n    </div>\n    <div class=\"fg\"><label class=\"fl\">Content</label><textarea class=\"fi\" id=\"artContent\" placeholder=\"Paste artifact content…\"></textarea></div>\n    <div class=\"pref-row\" onclick=\"togglePref('pref1')\"><span>⭐ Mark as preferred version</span><div class=\"tswitch\" id=\"pref1\"></div></div>\n    <button class=\"sub-btn\" onclick=\"saveArtifact()\">💾 Save Artifact</button>\n  </div>\n</div>\n\n<div class=\"sheet\" id=\"shareSheet\">\n  <div class=\"handle\"></div>\n  <div class=\"sheet-hdr\">\n    <div class=\"sheet-title\">Quick Save</div>\n    <div class=\"sheet-close\" onclick=\"closeSheets()\">✕</div>\n  </div>\n  <div class=\"sheet-body\">\n    <div class=\"fg\"><label class=\"fl\">Paste content from Claude</label><textarea class=\"fi\" id=\"pasteContent\" placeholder=\"Paste here…\" style=\"min-height:120px\"></textarea></div>\n    <div class=\"fg\"><label class=\"fl\">Name</label><input class=\"fi\" id=\"pasteName\" placeholder=\"e.g. my-script.py\"></div>\n    <div class=\"frow\">\n      <div class=\"fg\"><label class=\"fl\">Version</label><input class=\"fi\" id=\"pasteVer\" placeholder=\"v1\"></div>\n      <div class=\"fg\"><label class=\"fl\">Folder</label><select class=\"fi\" id=\"pasteFolder\"><option value=\"\">None</option></select></div>\n    </div>\n    <button class=\"sub-btn\" onclick=\"quickSave()\">💾 Save</button>\n  </div>\n</div>\n\n<div class=\"sheet\" id=\"verSheet\">\n  <div class=\"handle\"></div>\n  <div class=\"sheet-hdr\">\n    <div class=\"sheet-title\">Add Version</div>\n    <div class=\"sheet-close\" onclick=\"closeSheets()\">✕</div>\n  </div>\n  <div class=\"sheet-body\">\n    <input type=\"hidden\" id=\"verArtId\">\n    <div class=\"frow\">\n      <div class=\"fg\"><label class=\"fl\">Version</label><input class=\"fi\" id=\"verTag\" placeholder=\"v2\"></div>\n      <div class=\"fg\"><label class=\"fl\">Note</label><input class=\"fi\" id=\"verNote\" placeholder=\"What changed?\"></div>\n    </div>\n    <div class=\"fg\"><label class=\"fl\">Content</label><textarea class=\"fi\" id=\"verContent\" placeholder=\"Paste new version…\"></textarea></div>\n    <div class=\"pref-row\" onclick=\"togglePref('pref2')\"><span>⭐ Mark as preferred</span><div class=\"tswitch\" id=\"pref2\"></div></div>\n    <button class=\"sub-btn\" onclick=\"saveVersion()\">Add Version</button>\n  </div>\n</div>\n\n<div class=\"sheet\" id=\"folderSheet\">\n  <div class=\"handle\"></div>\n  <div class=\"sheet-hdr\">\n    <div class=\"sheet-title\">New Folder</div>\n    <div class=\"sheet-close\" onclick=\"closeSheets()\">✕</div>\n  </div>\n  <div class=\"sheet-body\">\n    <div class=\"fg\"><label class=\"fl\">Name</label><input class=\"fi\" id=\"folderName\" placeholder=\"e.g. Engineering\"></div>\n    <div class=\"fg\"><label class=\"fl\">Icon</label><div class=\"icon-grid\" id=\"iconGrid\"></div></div>\n    <button class=\"sub-btn\" onclick=\"saveFolder()\">Create Folder</button>\n  </div>\n</div>\n\n<div class=\"toast\" id=\"toast\"></div>\n\n<script>\n// localStorage storage\nconst AKEY='cam_arts', FKEY='cam_folders', IDKEY='cam_nid';\nconst getArts=()=>{try{return JSON.parse(localStorage.getItem(AKEY)||'[]')}catch{return[]}};\nconst getFolders=()=>{try{return JSON.parse(localStorage.getItem(FKEY)||'[]')}catch{return[]}};\nconst setArts=d=>localStorage.setItem(AKEY,JSON.stringify(d));\nconst setFolders=d=>localStorage.setItem(FKEY,JSON.stringify(d));\nlet nid=parseInt(localStorage.getItem(IDKEY)||'1');\nconst newId=()=>{const i=nid++;localStorage.setItem(IDKEY,nid);return i};\n\n// Init folders\nif(!localStorage.getItem(FKEY)){\n  setFolders([{id:1,name:'General',icon:'📁'},{id:2,name:'Engineering',icon:'🔧'},{id:3,name:'Finance',icon:'💰'},{id:4,name:'Marketing',icon:'🎨'},{id:5,name:'Legal',icon:'⚖️'}]);\n}\n\n// State\nlet tab='home',filter='all',search='',expanded=null,tags=[],prefs={pref1:false,pref2:false},selIcon='📁';\n\n// Helpers\nconst typeOf=n=>{if(!n)return'other';n=n.toLowerCase();if(n.endsWith('.py'))return'py';if(n.endsWith('.html')||n.endsWith('.htm'))return'html';if(n.endsWith('.xlsx')||n.endsWith('.xls')||n.endsWith('.csv'))return'xlsx';if(n.endsWith('.docx')||n.endsWith('.doc'))return'docx';if(n.endsWith('.jsx')||n.endsWith('.tsx'))return'react';if(n.endsWith('.sql'))return'sql';if(n.endsWith('.json'))return'json';if(n.endsWith('.md'))return'md';return'other'};\nconst emojiOf=t=>({html:'🌐',py:'🐍',xlsx:'📊',docx:'📝',react:'⚛',sql:'🗄',json:'{}',md:'📋',other:'📄'}[t]||'📄');\nconst fmtDate=ts=>{const d=Date.now()-ts;if(d<60000)return'Just now';if(d<3600000)return Math.floor(d/60000)+'m ago';if(d<86400000)return Math.floor(d/3600000)+'h ago';if(d<604800000)return Math.floor(d/86400000)+'d ago';return new Date(ts).toLocaleDateString()};\n\nfunction renderHome(){\n  let arts=getArts().filter(a=>{\n    if(filter==='starred')return a.starred;\n    if(filter!=='all')return typeOf(a.name)===filter;\n    return true;\n  }).filter(a=>{\n    if(!search)return true;\n    const q=search.toLowerCase();\n    return a.name.toLowerCase().includes(q)||(a.desc||'').toLowerCase().includes(q)||(a.tags||[]).some(t=>t.includes(q))||(a.versions||[]).some(v=>(v.note||'').toLowerCase().includes(q));\n  }).sort((a,b)=>b.createdAt-a.createdAt);\n  const c=document.getElementById('content');\n  if(!arts.length){c.innerHTML=`<div class=\"empty\"><div class=\"empty-icon\">${search?'🔍':'📦'}</div><div class=\"empty-title\">${search?'Nothing found':'No artifacts yet'}</div><div class=\"empty-sub\">${search?'Try different keywords':'Tap + to save your first artifact'}</div>${!search?'<button class=\"empty-btn\" onclick=\"openSheet(\\'saveSheet\\')\">Save first artifact</button>':''}</div>`;return}\n  c.innerHTML=`<div class=\"list-wrap\">${arts.map(a=>{\n    const type=typeOf(a.name),pref=(a.versions||[]).find(v=>v.preferred),latest=(a.versions||[])[(a.versions||[]).length-1],isExp=expanded===a.id,hasFile=(a.versions||[]).some(v=>v.content&&v.content.length>0);\n    return`<div class=\"card ${isExp?'expanded':''}\" id=\"card-${a.id}\">\n      <div class=\"card-body\" onclick=\"toggleCard(${a.id})\">\n        <div class=\"card-icon\">${emojiOf(type)}</div>\n        <div class=\"card-info\">\n          <div class=\"card-name\">${a.name}</div>\n          ${a.desc?`<div class=\"card-desc\">${a.desc}</div>`:''}\n          <div class=\"card-meta\">\n            <span class=\"chip chip-type\">${type.toUpperCase()}</span>\n            <span class=\"chip chip-v\">${(a.versions||[]).length}v</span>\n            ${pref?`<span class=\"chip chip-pref\">★ ${pref.v}</span>`:''}\n            <span style=\"font-size:11px;color:var(--muted2)\">${fmtDate(a.createdAt)}</span>\n          </div>\n          <div class=\"attach-indicator ${hasFile?'attach-ok':'attach-no'}\">${hasFile?'📎 File attached':'📎 No file'}</div>\n        </div>\n        <div class=\"card-right\">\n          <button class=\"star-btn ${a.starred?'on':''}\" onclick=\"event.stopPropagation();toggleStar(${a.id})\">${a.starred?'⭐':'☆'}</button>\n          <span class=\"vbadge\">${latest?latest.v:'v1'}</span>\n        </div>\n      </div>\n      <div class=\"card-detail ${isExp?'open':''}\" id=\"det-${a.id}\">\n        <div class=\"vlist\">\n          ${(a.versions||[]).map((v,i)=>`<div class=\"vrow\"><span class=\"vtag ${v.preferred?'pref':''}\">${v.v}</span><span class=\"vnote\">${v.note||'—'}</span><button class=\"vstar ${v.preferred?'on':''}\" onclick=\"setPref(${a.id},${i})\">${v.preferred?'⭐':'☆'}</button>${v.content?`<button class=\"vdl\" onclick=\"dlVer(${a.id},${i})\">⬇</button>`:''}</div>`).join('')}\n        </div>\n        <div class=\"card-actions\">\n          <button class=\"act-btn\" onclick=\"openAddVer(${a.id})\">+ Version</button>\n          <button class=\"act-btn\" onclick=\"openEdit(${a.id})\">✏ Edit</button>\n          <button class=\"act-btn\" onclick=\"triggerAttach(${a.id})\">📎 Attach</button>\n          <button class=\"act-btn\" onclick=\"showRebuild(${a.id})\">🤖 Rebuild</button>\n          <button class=\"act-btn danger\" onclick=\"delArt(${a.id})\">🗑</button>\n        </div>\n        <input type=\"file\" id=\"attach-${a.id}\" style=\"display:none\" onchange=\"attachFile(${a.id},this)\">\n        <div class=\"rebuild-box\" id=\"rebuild-${a.id}\">\n          <div style=\"font-weight:600;margin-bottom:4px\">📋 Copy this prompt into Claude:</div>\n          <div class=\"rebuild-prompt\">${buildRebuildPrompt(a)}</div>\n          <button class=\"copy-prompt-btn\" onclick=\"copyRebuildPrompt(${a.id})\">📋 Copy Prompt</button>\n        </div>\n      </div>\n    </div>`;\n  }).join('')}</div>`;\n}\n\nfunction toggleCard(id){expanded=expanded===id?null:id;renderHome();if(expanded)setTimeout(()=>{const el=document.getElementById('card-'+id);if(el)el.scrollIntoView({behavior:'smooth',block:'nearest'})},50)}\nfunction toggleStar(id){const arts=getArts(),a=arts.find(x=>x.id===id);if(!a)return;a.starred=!a.starred;setArts(arts);showToast(a.starred?'⭐ Starred':'Removed');renderHome()}\nfunction setPref(artId,vIdx){const arts=getArts(),a=arts.find(x=>x.id===artId);if(!a)return;a.versions.forEach(v=>v.preferred=false);a.versions[vIdx].preferred=true;setArts(arts);showToast(`★ ${a.versions[vIdx].v} preferred`);renderHome()}\nfunction delArt(id){if(!confirm('Delete this artifact?'))return;setArts(getArts().filter(a=>a.id!==id));if(expanded===id)expanded=null;showToast('Deleted');renderHome()}\nfunction dlVer(artId,vIdx){const a=getArts().find(x=>x.id===artId);if(!a||!a.versions[vIdx]?.content){showToast('No content saved');return}const v=a.versions[vIdx];const blob=new Blob([v.content],{type:'text/plain'});const url=URL.createObjectURL(blob);const l=document.createElement('a');l.href=url;l.download=a.name;l.click();URL.revokeObjectURL(url);showToast('⬇ Downloading…')}\n\nfunction renderFolders(){\n  const folders=getFolders(),arts=getArts(),counts={};\n  arts.forEach(a=>{if(a.folder)counts[a.folder]=(counts[a.folder]||0)+1});\n  document.getElementById('content').innerHTML=`<div class=\"folder-grid\">${folders.map(f=>`<div class=\"fcard\" onclick=\"switchTab('home')\"><div class=\"fcard-icon\">${f.icon||'📁'}</div><div class=\"fcard-name\">${f.name}</div><div class=\"fcard-count\">${counts[f.id]||0} artifact${counts[f.id]!==1?'s':''}</div></div>`).join('')}<div class=\"fcard add\" onclick=\"openSheet('folderSheet')\"><span style=\"font-size:22px\">+</span> New</div></div>`;\n}\n\nfunction renderSettings(){\n  const arts=getArts(),folders=getFolders();\n  document.getElementById('content').innerHTML=`<div class=\"stats-grid\"><div class=\"scard\"><div class=\"snum\">${arts.length}</div><div class=\"slabel\">Artifacts</div></div><div class=\"scard\"><div class=\"snum\">${arts.reduce((s,a)=>s+(a.versions?.length||0),0)}</div><div class=\"slabel\">Versions</div></div><div class=\"scard\"><div class=\"snum\" style=\"color:var(--amber)\">${arts.filter(a=>a.starred).length}</div><div class=\"slabel\">Starred</div></div><div class=\"scard\"><div class=\"snum\">${folders.length}</div><div class=\"slabel\">Folders</div></div></div><div class=\"exp-sec\"><div class=\"privacy-box\">🔒 All data stored <strong>locally on this device</strong>. Nothing sent to any server.</div><button class=\"exp-btn\" onclick=\"exportAll()\">⬇ Export all as JSON</button><button class=\"exp-btn\" onclick=\"document.getElementById('importFile').click()\">⬆ Import from JSON</button><input type=\"file\" id=\"importFile\" accept=\".json\" style=\"display:none\" onchange=\"handleImport(this)\"><button class=\"exp-btn danger\" onclick=\"clearAll()\">🗑 Clear all data</button></div>`;\n}\n\nfunction switchTab(t){\n  tab=t;\n  document.querySelectorAll('.nav-btn').forEach(b=>b.classList.remove('active'));\n  document.getElementById('nav-'+t)?.classList.add('active');\n  document.getElementById('fab').style.display=t==='home'?'flex':'none';\n  document.querySelector('.filter-row').style.display=t==='home'?'flex':'none';\n  if(t==='home')renderHome();\n  else if(t==='folders')renderFolders();\n  else if(t==='settings')renderSettings();\n}\n\nfunction onSearch(v){search=v;if(tab==='home')renderHome()}\nfunction setFilter(f,el){filter=f;expanded=null;document.querySelectorAll('.pill').forEach(p=>p.classList.remove('active'));el.classList.add('active');renderHome()}\nfunction togglePref(id){prefs[id]=!prefs[id];document.getElementById(id).classList.toggle('on',prefs[id])}\n\nfunction addTag(){const inp=document.getElementById('tagInput'),v=inp.value.trim().toLowerCase().replace(/\\s+/g,'-');if(!v||tags.includes(v)){inp.value='';return}tags.push(v);inp.value='';renderTags()}\nfunction renderTags(){document.getElementById('tagsWrap').innerHTML=tags.map((t,i)=>`<span class=\"tag-chip\">${t}<button onclick=\"removeTag(${i})\">×</button></span>`).join('')}\nfunction removeTag(i){tags.splice(i,1);renderTags()}\n\nfunction loadFolderSelects(){\n  const folders=getFolders();\n  ['artFolder','pasteFolder'].forEach(id=>{\n    const sel=document.getElementById(id);if(!sel)return;\n    const cur=sel.value;sel.innerHTML='<option value=\"\">None</option>';\n    folders.forEach(f=>{const o=document.createElement('option');o.value=f.id;o.textContent=`${f.icon} ${f.name}`;sel.appendChild(o)});\n    sel.value=cur;\n  });\n}\n\nfunction saveArtifact(){\n  const name=document.getElementById('artName').value.trim();\n  if(!name){showToast('⚠ Name required');return}\n  const editId=document.getElementById('editId').value;\n  const desc=document.getElementById('artDesc').value.trim();\n  const ver=document.getElementById('artVer').value.trim()||'v1';\n  const note=document.getElementById('artNote').value.trim();\n  const folder=document.getElementById('artFolder').value;\n  const content=document.getElementById('artContent').value.trim();\n  const arts=getArts();\n  if(editId){\n    const a=arts.find(x=>x.id===parseInt(editId));\n    if(a){a.name=name;a.desc=desc;a.folder=folder?parseInt(folder):null;a.tags=[...tags]}\n    setArts(arts);showToast(`✓ \"${name}\" updated`);\n  }else{\n    arts.push({id:newId(),name,desc,folder:folder?parseInt(folder):null,tags:[...tags],starred:false,createdAt:Date.now(),versions:[{v:ver,note:note||'Initial save',content,preferred:prefs.pref1,savedAt:Date.now()}]});\n    setArts(arts);showToast(`✓ \"${name}\" saved`);\n  }\n  closeSheets();resetSaveForm();if(tab==='home')renderHome();\n}\n\nfunction resetSaveForm(){\n  ['artName','artDesc','artVer','artNote','artContent','editId'].forEach(id=>{const el=document.getElementById(id);if(el)el.value=''});\n  tags=[];prefs.pref1=false;renderTags();\n  document.getElementById('pref1').classList.remove('on');\n  document.getElementById('saveTitle').textContent='Save Artifact';\n}\n\nfunction openEdit(id){\n  const a=getArts().find(x=>x.id===id);if(!a)return;\n  resetSaveForm();\n  document.getElementById('editId').value=id;\n  document.getElementById('artName').value=a.name;\n  document.getElementById('artDesc').value=a.desc||'';\n  document.getElementById('saveTitle').textContent='Edit Artifact';\n  tags=[...(a.tags||[])];renderTags();loadFolderSelects();\n  if(a.folder)document.getElementById('artFolder').value=a.folder;\n  openSheet('saveSheet');\n}\n\nfunction quickSave(){\n  const name=document.getElementById('pasteName').value.trim();\n  if(!name){showToast('⚠ Name required');return}\n  const content=document.getElementById('pasteContent').value.trim();\n  const ver=document.getElementById('pasteVer').value.trim()||'v1';\n  const folder=document.getElementById('pasteFolder').value;\n  const arts=getArts();\n  arts.push({id:newId(),name,desc:'',folder:folder?parseInt(folder):null,tags:[],starred:false,createdAt:Date.now(),versions:[{v:ver,note:'Quick save',content,preferred:false,savedAt:Date.now()}]});\n  setArts(arts);showToast(`✓ \"${name}\" saved`);\n  closeSheets();\n  ['pasteName','pasteContent','pasteVer'].forEach(id=>document.getElementById(id).value='');\n  if(tab==='home')renderHome();\n}\n\nfunction openAddVer(id){\n  const a=getArts().find(x=>x.id===id);if(!a)return;\n  document.getElementById('verArtId').value=id;\n  document.getElementById('verTag').value=`v${(a.versions?.length||0)+1}`;\n  document.getElementById('verNote').value='';document.getElementById('verContent').value='';\n  prefs.pref2=false;document.getElementById('pref2').classList.remove('on');\n  openSheet('verSheet');\n}\n\nfunction saveVersion(){\n  const artId=parseInt(document.getElementById('verArtId').value);\n  const tag=document.getElementById('verTag').value.trim()||'v?';\n  const note=document.getElementById('verNote').value.trim();\n  const content=document.getElementById('verContent').value.trim();\n  const arts=getArts(),a=arts.find(x=>x.id===artId);if(!a)return;\n  if(prefs.pref2)a.versions.forEach(v=>v.preferred=false);\n  a.versions.push({v:tag,note:note||'New version',content,preferred:prefs.pref2,savedAt:Date.now()});\n  setArts(arts);showToast(`✓ Version ${tag} added`);closeSheets();if(tab==='home')renderHome();\n}\n\nconst ICONS=['📁','📂','💼','🔧','🎨','📊','📝','🌐','🐍','⚙️','🔬','🎯','💡','🚀','💰','⚖️','🏗️','📱'];\nfunction setupIconGrid(){document.getElementById('iconGrid').innerHTML=ICONS.map(ic=>`<button class=\"icon-opt ${ic===selIcon?'sel':''}\" onclick=\"selectIcon('${ic}',this)\">${ic}</button>`).join('')}\nfunction selectIcon(icon,btn){selIcon=icon;document.querySelectorAll('.icon-opt').forEach(b=>b.classList.remove('sel'));btn.classList.add('sel')}\n\nfunction saveFolder(){\n  const name=document.getElementById('folderName').value.trim();if(!name){showToast('⚠ Name required');return}\n  const folders=getFolders();\n  const id=Math.max(0,...folders.map(f=>f.id))+1;\n  folders.push({id,name,icon:selIcon});setFolders(folders);\n  document.getElementById('folderName').value='';loadFolderSelects();closeSheets();\n  showToast(`📁 \"${name}\" created`);if(tab==='folders')renderFolders();\n}\n\nfunction exportAll(){\n  const data={exportedAt:new Date().toISOString(),artifacts:getArts(),folders:getFolders()};\n  const blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'});\n  const url=URL.createObjectURL(blob);const a=document.createElement('a');\n  a.href=url;a.download=`artifacts-${new Date().toISOString().slice(0,10)}.json`;\n  a.click();URL.revokeObjectURL(url);showToast(`⬇ Exported ${getArts().length} artifacts`);\n}\n\nfunction handleImport(input){\n  const file=input.files[0];if(!file)return;\n  const reader=new FileReader();\n  reader.onload=e=>{try{const data=JSON.parse(e.target.result);if(data.folders)setFolders(data.folders);if(data.artifacts)setArts(data.artifacts);showToast(`✓ Imported ${data.artifacts?.length||0} artifacts`);renderSettings()}catch{showToast('⚠ Invalid file')}};\n  reader.readAsText(file);input.value='';\n}\n\nfunction clearAll(){if(!confirm('Delete ALL data?'))return;[AKEY,FKEY,IDKEY].forEach(k=>localStorage.removeItem(k));nid=1;showToast('Cleared');renderSettings()}\n\nfunction openSheet(id){\n  document.getElementById('overlay').classList.add('show');\n  document.getElementById(id).classList.add('show');\n  if(id==='saveSheet'||id==='shareSheet')loadFolderSelects();\n  if(id==='folderSheet'){selIcon='📁';setupIconGrid()}\n}\nfunction closeSheets(){\n  document.getElementById('overlay').classList.remove('show');\n  document.querySelectorAll('.sheet').forEach(s=>s.classList.remove('show'));\n}\n\nlet toastTimer;\nfunction showToast(msg){const t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>t.classList.remove('show'),2500)}\n\nloadFolderSelects();\nswitchTab('home');\n\n// ── FILE ATTACH ───────────────────────────────────────────────────────────\nfunction triggerAttach(id){\n  const inp=document.getElementById('attach-'+id);\n  if(inp)inp.click();\n}\n\nfunction attachFile(artId,input){\n  const file=input.files[0];if(!file)return;\n  const reader=new FileReader();\n  reader.onload=e=>{\n    const arts=getArts(),a=arts.find(x=>x.id===artId);if(!a)return;\n    // Attach to latest version\n    const latest=a.versions[a.versions.length-1];\n    if(latest){\n      latest.content=e.target.result;\n      latest.fileName=file.name;\n      latest.fileSize=file.size;\n    }\n    setArts(arts);\n    showToast(`📎 \"${file.name}\" attached`);\n    renderHome();\n  };\n  reader.readAsText(file);\n  input.value='';\n}\n\n// ── REBUILD PROMPT ────────────────────────────────────────────────────────\nfunction buildRebuildPrompt(a){\n  const pref=(a.versions||[]).find(v=>v.preferred)||a.versions?.[a.versions.length-1];\n  const ver=pref?pref.v:'latest version';\n  const note=pref?.note?` (${pref.note})`:'';\n  return `Please re-send or rebuild \"${a.name}\" ${ver}${note}. ${a.desc||''}`.trim();\n}\n\nfunction showRebuild(id){\n  const box=document.getElementById('rebuild-'+id);\n  if(!box)return;\n  box.classList.toggle('show');\n}\n\nfunction copyRebuildPrompt(id){\n  const a=getArts().find(x=>x.id===id);if(!a)return;\n  const prompt=buildRebuildPrompt(a);\n  if(navigator.clipboard){\n    navigator.clipboard.writeText(prompt).then(()=>showToast('📋 Prompt copied — paste into Claude!')).catch(()=>fallbackCopy(prompt));\n  } else { fallbackCopy(prompt); }\n}\n\nfunction fallbackCopy(text){\n  const ta=document.createElement('textarea');\n  ta.value=text;ta.style.position='fixed';ta.style.opacity='0';\n  document.body.appendChild(ta);ta.select();\n  try{document.execCommand('copy');showToast('📋 Prompt copied!')}catch{showToast('⚠ Copy manually from the box')}\n  document.body.removeChild(ta);\n}\n\n</script>\n</body>\n</html>\n",
