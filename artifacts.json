        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Claude Artifact Manager — Phillip Richards</title>\n<link href=\"https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap\" rel=\"stylesheet\">\n<style>\n  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n\n  :root {\n    --bg:         #f7f5f1;\n    --surface:    #ffffff;\n    --surface2:   #f2ede6;\n    --surface3:   #ece7de;\n    --border:     #e8e2d8;\n    --border2:    #d5cdc2;\n    --text:       #1c1914;\n    --muted:      #7a7268;\n    --subtle:     #a8a09a;\n    --accent:     #d97757;\n    --accent-dk:  #c26840;\n    --accent-bg:  rgba(217,119,87,.09);\n    --accent-brd: rgba(217,119,87,.28);\n    --green:      #4a9868;\n    --green-bg:   rgba(74,152,104,.08);\n    --green-brd:  rgba(74,152,104,.22);\n    --blue:       #3c79d8;\n    --purple:     #8058c2;\n    --red:        #c54545;\n    --cyan:       #2b9aaa;\n    --tag-bg:     #ede8e0;\n  }\n\n  body {\n    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;\n    background: var(--bg); color: var(--text);\n    height: 100vh; display: flex; flex-direction: column;\n    overflow: hidden; -webkit-font-smoothing: antialiased;\n  }\n\n  /* TOPBAR */\n  .topbar { display:flex; align-items:center; gap:16px; padding:0 20px; height:52px; background:var(--surface); border-bottom:1px solid var(--border); flex-shrink:0; }\n  .topbar-logo { display:flex; align-items:center; gap:9px; font-weight:600; font-size:14px; letter-spacing:-.2px; }\n  .logo-mark, .logo-icon { width:28px; height:28px; background:linear-gradient(145deg,#d97757,#c06040); border-radius:7px; display:flex; align-items:center; justify-content:center; color:white; font-size:13px; flex-shrink:0; box-shadow:0 1px 4px rgba(192,96,64,.22); }\n  .owner-badge { font-size:10.5px; padding:2px 7px; background:var(--accent-bg); color:var(--accent); border-radius:4px; font-weight:600; margin-left:2px; border:1px solid var(--accent-brd); }\n  .topbar-center { flex:1; display:flex; align-items:center; gap:10px; max-width:480px; margin:0 auto; }\n  .search-wrap { position:relative; flex:1; }\n  .search-input { width:100%; background:var(--bg); border:1px solid var(--border); border-radius:8px; padding:7px 12px 7px 32px; color:var(--text); font-family:inherit; font-size:13px; outline:none; transition:border-color .15s,box-shadow .15s; }\n  .search-input:focus { border-color:var(--accent); background:var(--surface); box-shadow:0 0 0 3px var(--accent-bg); }\n  .search-input::placeholder { color:var(--subtle); }\n  .search-icon { position:absolute; left:9px; top:50%; transform:translateY(-50%); color:var(--subtle); pointer-events:none; display:flex; }\n  .topbar-right { display:flex; align-items:center; gap:8px; margin-left:auto; }\n  .btn { padding:6px 13px; border-radius:7px; border:none; font-family:inherit; font-size:12.5px; font-weight:500; cursor:pointer; transition:all .15s; }\n  .btn-primary { background:var(--accent); color:white; }\n  .btn-primary:hover { background:var(--accent-dk); }\n  .btn-ghost { background:transparent; color:var(--muted); border:1px solid var(--border); }\n  .btn-ghost:hover { color:var(--text); border-color:var(--border2); background:var(--surface2); }\n  .avatar { width:28px; height:28px; border-radius:50%; background:linear-gradient(145deg,#d97757,#c06040); display:flex; align-items:center; justify-content:center; font-size:10.5px; font-weight:700; color:white; flex-shrink:0; }\n\n  /* WORKSPACE */\n  .workspace { display:flex; flex:1; overflow:hidden; }\n\n  /* LOAD SCREEN */\n  .load-screen { flex:1; display:flex; align-items:center; justify-content:center; background:var(--bg); }\n  .load-box { background:var(--surface); border:1px solid var(--border); border-radius:16px; padding:40px 48px; display:flex; flex-direction:column; align-items:center; gap:16px; max-width:420px; text-align:center; box-shadow:0 2px 16px rgba(0,0,0,.06); }\n  .load-icon { width:52px; height:52px; background:linear-gradient(145deg,#d97757,#c06040); border-radius:14px; display:flex; align-items:center; justify-content:center; color:white; font-size:22px; box-shadow:0 4px 14px rgba(192,96,64,.2); }\n  .load-title { font-size:18px; font-weight:700; }\n  .load-desc { font-size:13px; color:var(--muted); line-height:1.65; }\n  .load-btn { padding:10px 24px; border-radius:9px; border:1.5px dashed var(--border2); background:transparent; color:var(--text); font-family:inherit; font-size:13.5px; font-weight:500; cursor:pointer; transition:all .2s; width:100%; }\n  .load-btn:hover { border-color:var(--accent); color:var(--accent); background:var(--accent-bg); }\n  .load-hint { font-size:11px; color:var(--subtle); }\n\n  /* SIDEBAR */\n  .sidebar { width:236px; flex-shrink:0; background:var(--surface); border-right:1px solid var(--border); display:flex; flex-direction:column; overflow:hidden; }\n  .sidebar-scroll { flex:1; overflow-y:auto; padding:8px 8px 4px; }\n  .sidebar-section { padding:4px 0; }\n  .sidebar-label { font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:1px; color:var(--subtle); padding:8px 10px 5px; }\n  .nav-item { display:flex; align-items:center; gap:8px; padding:6px 10px; border-radius:7px; cursor:pointer; font-size:13px; color:var(--muted); transition:all .12s; user-select:none; margin-bottom:1px; }\n  .nav-item:hover { background:var(--surface2); color:var(--text); }\n  .nav-item.active { background:var(--accent-bg); color:var(--accent); font-weight:500; }\n  .nav-item.active .nav-count { background:rgba(217,119,87,.14); color:var(--accent); }\n  .nav-count { margin-left:auto; font-size:10.5px; background:var(--surface2); color:var(--muted); padding:1px 6px; border-radius:10px; min-width:20px; text-align:center; }\n  .starred-nav { display:flex; align-items:center; gap:8px; padding:6px 10px; border-radius:7px; cursor:pointer; font-size:13px; color:var(--accent); font-weight:500; transition:all .12s; margin-bottom:1px; }\n  .starred-nav:hover { background:var(--accent-bg); }\n  .sidebar-footer { border-top:1px solid var(--border); padding:12px 14px; }\n  .storage-bar-bg { height:3px; background:var(--surface2); border-radius:2px; margin:7px 0 4px; }\n  .storage-bar-fill { height:100%; border-radius:2px; background:linear-gradient(90deg,var(--accent),var(--accent-dk)); }\n  .storage-label { font-size:11px; color:var(--muted); }\n  .detail-section-title { font-size:10.5px; font-weight:700; text-transform:uppercase; letter-spacing:1px; color:var(--subtle); margin-bottom:10px; }\n  .load-new-btn { width:100%; margin-top:5px; padding:5px; border-radius:6px; border:1px dashed var(--border2); background:transparent; color:var(--muted); font-family:inherit; font-size:11px; cursor:pointer; transition:all .15s; }\n  .load-new-btn:hover { border-color:var(--accent-brd); color:var(--accent); }\n\n  /* MAIN */\n  .main { flex:1; display:flex; flex-direction:column; overflow:hidden; background:var(--bg); }\n  .main-header { padding:12px 18px 10px; border-bottom:1px solid var(--border); background:var(--surface); flex-shrink:0; }\n  .main-header-top { display:flex; align-items:flex-start; gap:12px; margin-bottom:10px; }\n  .main-title { font-size:15px; font-weight:600; }\n  .main-subtitle { font-size:11.5px; color:var(--muted); margin-top:2px; }\n  .header-actions { margin-left:auto; display:flex; gap:8px; align-items:center; }\n  .filter-row { display:flex; align-items:center; gap:4px; flex-wrap:nowrap; overflow-x:auto; scrollbar-width:none; }\n  .filter-row::-webkit-scrollbar { display:none; }\n  .pill { padding:4px 11px; border-radius:20px; font-size:11.5px; border:1px solid var(--border); cursor:pointer; transition:all .12s; color:var(--muted); background:transparent; font-family:inherit; white-space:nowrap; flex-shrink:0; }\n  .pill:hover { border-color:var(--border2); color:var(--text); background:var(--surface2); }\n  .pill.active { border-color:var(--accent-brd); color:var(--accent); background:var(--accent-bg); }\n  .sort-select { background:var(--surface); border:1px solid var(--border); border-radius:7px; color:var(--muted); font-family:inherit; font-size:11.5px; padding:4px 8px; cursor:pointer; outline:none; flex-shrink:0; }\n  .view-toggle { display:flex; gap:2px; background:var(--bg); border:1px solid var(--border); border-radius:7px; padding:2px; }\n  .view-btn { background:none; border:none; cursor:pointer; padding:3px 7px; border-radius:5px; font-size:13px; color:var(--muted); transition:all .12s; }\n  .view-btn.active { background:var(--surface); color:var(--text); box-shadow:0 1px 3px rgba(0,0,0,.06); }\n\n  /* ARTIFACT LIST */\n  .artifact-list { flex:1; overflow-y:auto; padding:10px 14px; }\n  .artifact-list.grid-view { display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:8px; align-content:start; }\n\n  /* CARDS */\n  .artifact-card { background:var(--surface); border:1px solid var(--border); border-radius:10px; overflow:hidden; transition:border-color .15s,box-shadow .15s; margin-bottom:5px; }\n  .artifact-card:hover { border-color:var(--border2); box-shadow:0 2px 10px rgba(0,0,0,.05); }\n  .artifact-card.expanded { border-color:var(--accent-brd); box-shadow:0 0 0 2px var(--accent-bg); }\n  .card-main { display:flex; align-items:center; gap:11px; padding:11px 13px; cursor:pointer; min-height:60px; }\n  .type-badge { width:36px; height:36px; border-radius:9px; display:flex; align-items:center; justify-content:center; font-size:15px; flex-shrink:0; }\n  .type-html{background:rgba(217,119,87,.10);} .type-css{background:rgba(60,121,216,.10);} .type-svg{background:rgba(217,119,87,.10);} .type-xml{background:rgba(128,88,194,.10);}\n  .type-py{background:rgba(74,152,104,.10);} .type-jsx{background:rgba(44,154,170,.10);} .type-tsx{background:rgba(44,154,170,.10);} .type-ts{background:rgba(60,121,216,.10);}\n  .type-js{background:rgba(217,119,87,.10);} .type-vue{background:rgba(74,152,104,.10);} .type-rb{background:rgba(197,68,68,.10);} .type-php{background:rgba(128,88,194,.10);}\n  .type-java{background:rgba(197,68,68,.10);} .type-rs{background:rgba(217,119,87,.10);} .type-go{background:rgba(44,154,170,.10);} .type-sh{background:rgba(74,152,104,.10);}\n  .type-sql{background:rgba(197,68,68,.10);} .type-json{background:rgba(128,88,194,.10);} .type-csv{background:rgba(74,152,104,.10);} .type-yaml{background:rgba(217,119,87,.10);}\n  .type-toml{background:rgba(217,119,87,.10);} .type-md{background:rgba(74,152,104,.10);} .type-txt{background:rgba(160,144,144,.10);} .type-docx{background:rgba(128,88,194,.10);}\n  .type-xlsx{background:rgba(60,121,216,.10);} .type-pptx{background:rgba(197,68,68,.10);} .type-pdf{background:rgba(197,68,68,.10);} .type-zip{background:rgba(197,68,68,.10);}\n  .type-mp4{background:rgba(44,154,170,.10);} .type-mp3{background:rgba(44,154,170,.10);} .type-other{background:rgba(160,144,144,.10);}\n  .card-info { flex:1; min-width:0; overflow:hidden; }\n  .card-name { font-family:'JetBrains Mono',monospace; font-size:12px; font-weight:500; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; display:block; width:100%; }\n  .card-desc { font-size:11px; color:var(--muted); margin-top:3px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }\n  .card-meta { display:flex; align-items:center; gap:5px; margin-top:4px; font-size:11px; color:var(--muted); flex-wrap:wrap; min-width:0; }\n  .card-tags { display:flex; gap:3px; flex-wrap:wrap; }\n  .tag { padding:2px 6px; border-radius:4px; background:var(--tag-bg); font-size:10px; color:var(--muted); font-weight:500; }\n  .card-right { display:flex; align-items:center; gap:7px; flex-shrink:0; }\n  .version-count { font-size:11px; color:var(--muted); background:var(--surface2); padding:2px 8px; border-radius:5px; font-family:'JetBrains Mono',monospace; white-space:nowrap; }\n  .star-btn { background:none; border:none; cursor:pointer; font-size:17px; line-height:1; transition:transform .12s,color .12s; padding:2px; color:var(--border2); }\n  .star-btn:hover { transform:scale(1.2); color:var(--accent); }\n  .star-btn.starred { color:var(--accent); }\n  .expand-icon { color:var(--border2); font-size:11px; transition:transform .2s; }\n  .expanded .expand-icon { transform:rotate(180deg); }\n\n  /* VERSION DRAWER */\n  .version-drawer { display:none; border-top:1px solid var(--border); }\n  .version-drawer.open { display:block; }\n  .drawer-header { padding:7px 13px; font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:1px; color:var(--subtle); border-bottom:1px solid var(--border); display:flex; align-items:center; gap:8px; background:var(--bg); }\n  .version-row { display:flex; align-items:center; gap:10px; padding:8px 13px; border-bottom:1px solid var(--border); transition:background .12s; background:var(--bg); }\n  .version-row:last-child { border-bottom:none; }\n  .version-row:hover { background:var(--surface2); }\n  .version-tag { font-family:'JetBrains Mono',monospace; font-size:10.5px; font-weight:600; padding:2px 7px; border-radius:5px; background:var(--surface); border:1px solid var(--border); color:var(--text); min-width:32px; text-align:center; flex-shrink:0; }\n  .version-tag.preferred { background:var(--accent-bg); color:var(--accent); border-color:var(--accent-brd); }\n  .preferred-badge { font-size:10px; padding:2px 6px; border-radius:4px; background:var(--accent-bg); color:var(--accent); font-weight:700; flex-shrink:0; }\n  .version-note { flex:1; font-size:11px; color:var(--muted); font-style:italic; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }\n  .version-date { font-size:10.5px; color:var(--subtle); flex-shrink:0; min-width:65px; text-align:right; }\n  .version-star { background:none; border:none; cursor:pointer; font-size:14px; transition:all .15s; padding:2px 3px; border-radius:4px; color:var(--border2); }\n  .version-star:hover { background:var(--accent-bg); color:var(--accent); }\n  .version-star.starred { color:var(--accent); }\n\n  /* CARD ACTIONS */\n  .card-action-row { display:flex; gap:5px; padding:7px 13px 10px; border-top:1px solid var(--border); background:var(--bg); flex-wrap:wrap; }\n  .act-btn { flex:1; min-width:70px; padding:6px 8px; border-radius:7px; border:1px solid var(--border); background:var(--surface); font-size:11.5px; font-weight:500; color:var(--muted); cursor:pointer; font-family:inherit; transition:all .12s; text-align:center; white-space:nowrap; }\n  .act-btn:hover { border-color:var(--border2); color:var(--text); background:var(--surface2); }\n  .act-btn.attach-ok { border-color:var(--green-brd); color:var(--green); }\n  .rebuild-box { display:none; margin:0 13px 10px; background:var(--green-bg); border:1px solid var(--green-brd); border-radius:9px; padding:11px; }\n  .rebuild-box.show { display:block; }\n  .rebuild-title { font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:.8px; color:var(--green); margin-bottom:8px; }\n  .rebuild-prompt { font-family:'JetBrains Mono',monospace; font-size:11px; background:var(--surface); border:1px solid var(--border); border-radius:6px; padding:9px; color:var(--text); line-height:1.6; word-break:break-word; margin-bottom:8px; }\n  .copy-btn { width:100%; padding:7px; border-radius:7px; background:var(--green); border:none; color:white; font-family:inherit; font-size:12px; font-weight:600; cursor:pointer; transition:filter .15s; }\n  .copy-btn:hover { filter:brightness(1.08); }\n\n  /* GRID VIEW */\n  .grid-view .artifact-card .card-main { flex-direction:column; align-items:flex-start; padding:13px; }\n  .grid-view .card-right { width:100%; justify-content:flex-end; margin-top:8px; }\n  .grid-view .version-drawer { display:none !important; }\n\n  /* DETAIL PANEL */\n  .detail-panel { width:272px; flex-shrink:0; background:var(--surface); border-left:1px solid var(--border); display:flex; flex-direction:column; overflow:hidden; }\n  .detail-scroll { flex:1; overflow-y:auto; padding:16px; display:flex; flex-direction:column; gap:18px; }\n  .stat-grid { display:grid; grid-template-columns:1fr 1fr; gap:6px; }\n  .stat-box { background:var(--bg); border-radius:8px; padding:10px; text-align:center; border:1px solid var(--border); }\n  .stat-num { font-size:21px; font-weight:700; }\n  .stat-label { font-size:10px; color:var(--muted); margin-top:2px; }\n  .detail-row { display:flex; flex-direction:column; gap:3px; margin-bottom:10px; }\n  .detail-label { font-size:10px; text-transform:uppercase; letter-spacing:.8px; color:var(--subtle); font-weight:600; }\n  .detail-value { font-size:12.5px; color:var(--text); }\n  .detail-value.mono { font-family:'JetBrains Mono',monospace; font-size:11.5px; }\n  .activity-item { display:flex; align-items:flex-start; gap:8px; margin-bottom:7px; font-size:11.5px; color:var(--muted); }\n  .activity-dot { width:6px; height:6px; border-radius:50%; margin-top:4px; flex-shrink:0; }\n\n  /* TOAST */\n  .toast { position:fixed; bottom:20px; left:50%; transform:translateX(-50%) translateY(70px); background:var(--text); color:var(--surface); border-radius:10px; padding:9px 18px; font-size:13px; display:flex; align-items:center; gap:8px; transition:transform .25s cubic-bezier(.34,1.56,.64,1); z-index:999; white-space:nowrap; box-shadow:0 4px 16px rgba(0,0,0,.14); pointer-events:none; }\n  .toast.show { transform:translateX(-50%) translateY(0); }\n\n  /* SCROLLBAR */\n  ::-webkit-scrollbar { width:4px; } ::-webkit-scrollbar-track { background:transparent; } ::-webkit-scrollbar-thumb { background:var(--border2); border-radius:2px; }\n\n  /* EMPTY STATE */\n  .empty-state { display:flex; flex-direction:column; align-items:center; justify-content:center; height:200px; color:var(--muted); font-size:13.5px; gap:8px; }\n  .empty-icon { font-size:32px; opacity:.3; }\n\n  /* FOLDER TREE */\n  .folder-tree-item { position:relative; }\n  .folder-row { display:flex; align-items:center; padding:5px 10px; border-radius:7px; cursor:pointer; font-size:13px; color:var(--muted); transition:all .12s; user-select:none; gap:4px; margin-bottom:1px; }\n  .folder-row:hover { background:var(--surface2); color:var(--text); }\n  .folder-row:hover .folder-actions { opacity:1; }\n  .folder-row.active { background:var(--accent-bg); color:var(--accent); font-weight:500; }\n  .folder-row.active .f-count { background:rgba(217,119,87,.12); color:var(--accent); }\n  .f-toggle { width:14px; font-size:8px; flex-shrink:0; color:var(--subtle); transition:transform .15s; cursor:pointer; text-align:center; }\n  .f-toggle.open { transform:rotate(90deg); }\n  .f-toggle.leaf { opacity:0; pointer-events:none; }\n  .f-icon { font-size:13px; flex-shrink:0; }\n  .f-name { flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }\n  .f-count { font-size:10px; background:var(--surface2); color:var(--muted); padding:1px 5px; border-radius:8px; flex-shrink:0; }\n  .folder-actions { opacity:0; display:flex; gap:2px; flex-shrink:0; transition:opacity .12s; }\n  .f-act { background:none; border:none; cursor:pointer; font-size:11px; color:var(--subtle); padding:2px 3px; border-radius:4px; line-height:1; }\n  .f-act:hover { background:var(--surface3); color:var(--text); }\n  .folder-children { padding-left:14px; border-left:1px solid var(--border); margin-left:15px; }\n  .add-root-folder { display:flex; align-items:center; gap:6px; padding:5px 10px; border-radius:7px; cursor:pointer; font-size:12px; color:var(--subtle); transition:all .12s; margin-top:4px; border:1px dashed transparent; }\n  .add-root-folder:hover { border-color:var(--border2); color:var(--accent); }\n\n  /* DRAG */\n  .artifact-card[draggable=true] { cursor:grab; }\n  .artifact-card.dragging { opacity:.3; border-style:dashed; }\n  .drag-handle { color:var(--border2); font-size:12px; padding:0 3px; cursor:grab; flex-shrink:0; opacity:0; transition:opacity .12s; }\n  .artifact-card:hover .drag-handle { opacity:1; }\n  .folder-row.drop-target { background:var(--accent-bg) !important; border:1px solid var(--accent-brd) !important; color:var(--accent) !important; }\n  .folder-row.drop-forbidden { background:rgba(197,68,68,.06) !important; border:1px solid rgba(197,68,68,.2) !important; }\n\n  /* MODALS */\n  .modal-overlay { position:fixed; inset:0; background:rgba(0,0,0,.2); backdrop-filter:blur(3px); z-index:200; display:none; align-items:center; justify-content:center; }\n  .modal-overlay.show { display:flex; }\n  .modal { background:var(--surface); border:1px solid var(--border2); border-radius:14px; padding:22px; width:360px; display:flex; flex-direction:column; gap:14px; box-shadow:0 20px 50px rgba(0,0,0,.10); }\n  .modal-title { font-size:15px; font-weight:700; }\n  .modal-field { display:flex; flex-direction:column; gap:5px; }\n  .modal-label { font-size:10.5px; font-weight:700; text-transform:uppercase; letter-spacing:.8px; color:var(--subtle); }\n  .modal-input { background:var(--bg); border:1px solid var(--border); border-radius:8px; padding:8px 11px; color:var(--text); font-family:inherit; font-size:13.5px; outline:none; transition:border-color .15s,box-shadow .15s; }\n  .modal-input:focus { border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-bg); }\n  .modal-emoji-grid { display:flex; flex-wrap:wrap; gap:3px; }\n  .modal-emoji { font-size:19px; padding:4px; border-radius:6px; cursor:pointer; border:2px solid transparent; transition:all .12s; background:none; }\n  .modal-emoji:hover { background:var(--surface2); }\n  .modal-emoji.sel { border-color:var(--accent); background:var(--accent-bg); }\n  .modal-actions { display:flex; gap:8px; justify-content:flex-end; margin-top:4px; }\n  .modal-btn { padding:8px 16px; border-radius:8px; border:none; font-family:inherit; font-size:13px; font-weight:600; cursor:pointer; transition:all .12s; }\n  .modal-btn-primary { background:var(--accent); color:white; }\n  .modal-btn-primary:hover { background:var(--accent-dk); }\n  .modal-btn-cancel { background:var(--surface2); color:var(--muted); }\n  .modal-btn-cancel:hover { background:var(--surface3); color:var(--text); }\n  .modal-btn-danger { background:rgba(197,68,68,.08); color:var(--red); border:1px solid rgba(197,68,68,.2); }\n  .modal-btn-danger:hover { background:rgba(197,68,68,.14); }\n  .tswitch { width:38px; height:21px; background:var(--border2); border-radius:11px; position:relative; transition:background .2s; flex-shrink:0; cursor:pointer; }\n  .tswitch::after { content:''; position:absolute; width:15px; height:15px; background:white; border-radius:50%; top:3px; left:3px; transition:transform .2s; box-shadow:0 1px 3px rgba(0,0,0,.18); }\n  .tswitch.on { background:var(--accent); }\n  .tswitch.on::after { transform:translateX(17px); }\n\n  /* CONTEXT MENU */\n  .ctx-menu { position:fixed; background:var(--surface); border:1px solid var(--border2); border-radius:10px; padding:4px; z-index:500; min-width:166px; box-shadow:0 8px 24px rgba(0,0,0,.10),0 2px 6px rgba(0,0,0,.06); display:none; }\n  .ctx-menu.show { display:block; }\n  .ctx-item { padding:7px 11px; border-radius:6px; font-size:12.5px; cursor:pointer; color:var(--muted); transition:all .1s; display:flex; align-items:center; gap:8px; }\n  .ctx-item:hover { background:var(--surface2); color:var(--text); }\n  .ctx-item.danger { color:var(--red); }\n  .ctx-item.danger:hover { background:rgba(197,68,68,.06); }\n  /* GITHUB SYNC */\n  .gh-status { font-size:11px; color:var(--muted); display:flex; align-items:center; gap:5px; white-space:nowrap; }\n  .gh-dot { width:7px; height:7px; border-radius:50%; background:var(--border2); flex-shrink:0; }\n  .gh-dot.connected { background:var(--green); }\n  .gh-dot.syncing { background:var(--accent); animation:pulse .8s infinite alternate; }\n  .gh-dot.error { background:var(--red); }\n  @keyframes pulse { from{opacity:.4} to{opacity:1} }\n  .btn-gh-push { background:var(--green-bg); color:var(--green); border:1px solid var(--green-brd); }\n  .btn-gh-push:hover { background:rgba(74,152,104,.14); }\n  .btn-gh-pull { background:rgba(60,121,216,.08); color:var(--blue); border:1px solid rgba(60,121,216,.22); }\n  .btn-gh-pull:hover { background:rgba(60,121,216,.13); }\n  .btn-gear { background:transparent; border:1px solid var(--border); color:var(--muted); padding:6px 9px; font-size:14px; }\n  .btn-gear:hover { color:var(--text); border-color:var(--border2); background:var(--surface2); }\n  .modal-wide { width:420px; }\n  .modal-hint { font-size:11px; color:var(--subtle); line-height:1.5; }\n  .modal-input-mono { font-family:'JetBrains Mono',monospace; font-size:12px; }\n  .gh-status-panel { display:flex; align-items:center; gap:8px; padding:9px 12px; background:var(--bg); border:1px solid var(--border); border-radius:8px; font-size:12px; color:var(--muted); }\n  .gh-time-row { display:flex; justify-content:space-between; font-size:11px; color:var(--subtle); margin-top:4px; }\n  .ctx-divider { height:1px; background:var(--border); margin:3px 0; }\n</style>\n</head>\n<body>\n\n<!-- TOP BAR -->\n<div class=\"topbar\">\n  <div class=\"topbar-logo\">\n    <div class=\"logo-icon\">⬡</div>\n    Artifact Manager\n    <span class=\"owner-badge\" id=\"ownerBadge\">Personal</span>\n  </div>\n  <div class=\"topbar-center\">\n    <div class=\"search-wrap\">\n      <span class=\"search-icon\">🔍</span>\n      <input class=\"search-input\" id=\"searchInput\" placeholder=\"Search artifacts, tags, descriptions…\" oninput=\"doSearch()\">\n    </div>\n    <button class=\"btn btn-primary\" id=\"newArtifactBtn\" onclick=\"document.getElementById('newArtifactFile').click()\" style=\"display:none;white-space:nowrap\">+ New</button>\n    <input type=\"file\" id=\"newArtifactFile\" style=\"display:none\" onchange=\"onNewArtifactFile(this)\">\n  </div>\n  <div class=\"topbar-right\">\n    <div class=\"gh-status\" id=\"ghStatus\">\n      <span class=\"gh-dot\" id=\"ghDot\"></span>\n      <span id=\"ghStatusText\">Not configured</span>\n    </div>\n    <button class=\"btn btn-gh-push\" id=\"ghPushBtn\" onclick=\"ghPush()\" title=\"Push catalogue to GitHub\" style=\"display:none\">⬆ Push</button>\n    <button class=\"btn btn-gh-pull\" id=\"ghPullBtn\" onclick=\"ghPull()\" title=\"Pull catalogue from GitHub\" style=\"display:none\">⬇ Pull</button>\n    <button class=\"btn btn-ghost\" onclick=\"exportDelta()\" title=\"Export delta JSON (local backup)\">⬇ Delta</button>\n    <button class=\"btn btn-ghost btn-gear\" onclick=\"openSettingsModal()\" title=\"Settings\">⚙</button>\n    <input type=\"file\" id=\"fileInput\" accept=\".json\" style=\"display:none\" onchange=\"loadFile(this)\">\n    <div class=\"avatar\" title=\"Phillip Richards\">PR</div>\n  </div>\n</div>\n\n<div class=\"workspace\" id=\"workspace\">\n\n  <!-- LOAD SCREEN (shown until JSON loaded) -->\n  <div class=\"load-screen\" id=\"loadScreen\">\n    <div class=\"load-box\">\n      <div class=\"load-icon\">⬡</div>\n      <div class=\"load-title\">Load your catalogue</div>\n      <div class=\"load-desc\">Drop your <code style=\"background:var(--surface2);padding:2px 6px;border-radius:4px;font-family:monospace;font-size:12px\">historic-artifacts.json</code> to populate your personal Artifact Manager with your real projects and versions.</div>\n      <button class=\"load-btn\" onclick=\"document.getElementById('fileInput').click()\">📂 Choose JSON file…</button>\n      <div class=\"load-hint\">Or drag and drop the file anywhere on this page</div>\n    </div>\n  </div>\n\n  <!-- MAIN INTERFACE (hidden until JSON loaded) -->\n  <div id=\"mainInterface\" style=\"display:none;flex:1;display:none;overflow:hidden;flex-direction:row\" class=\"workspace-inner\">\n\n    <!-- SIDEBAR -->\n    <div class=\"sidebar\">\n      <div class=\"sidebar-scroll\">\n\n        <div class=\"sidebar-section\">\n          <div class=\"sidebar-label\">Views</div>\n          <div class=\"nav-item active\" id=\"nav-all\" onclick=\"selectView('all',this)\">⊞ All Artifacts <span class=\"nav-count\" id=\"count-all\">0</span></div>\n          <div class=\"starred-nav\" id=\"nav-starred\" onclick=\"selectView('starred',this)\">★ Favourites <span style=\"margin-left:auto;font-size:11px\" id=\"count-starred\">0</span></div>\n          <div class=\"nav-item\" id=\"nav-recent\" onclick=\"selectView('recent',this)\">🕐 Recent <span class=\"nav-count\" id=\"count-recent\">0</span></div>\n        </div>\n\n        <div class=\"sidebar-section\">\n          <div class=\"sidebar-label\">Folders</div>\n          <div id=\"folderNav\"></div>\n        </div>\n\n      </div>\n\n      <div class=\"sidebar-footer\">\n        <div class=\"detail-section-title\">Catalogue</div>\n        <div class=\"storage-label\" id=\"storageLabel\">— artifacts · — versions</div>\n        <div class=\"storage-bar-bg\"><div class=\"storage-bar-fill\" id=\"storageBar\" style=\"width:0%\"></div></div>\n        <div class=\"storage-label\" id=\"storageDate\">Personal workspace</div>\n        <button class=\"load-new-btn\" style=\"margin-top:6px\" onclick=\"document.getElementById('fileInput').click()\">⤴ Merge / load JSON</button>\n        <button class=\"load-new-btn\" style=\"margin-top:4px\" onclick=\"exportFull()\">⬇ Full export</button>\n        <button class=\"load-new-btn\" style=\"margin-top:4px;color:var(--red);border-color:rgba(248,81,73,.3)\" onclick=\"clearStorage()\">🗑 Clear local storage</button>\n      </div>\n    </div>\n\n    <!-- MAIN CONTENT -->\n    <div class=\"main\">\n      <div class=\"main-header\">\n        <div class=\"main-header-top\">\n          <div>\n            <div class=\"main-title\" id=\"viewTitle\">All Artifacts</div>\n            <div class=\"main-subtitle\" id=\"viewSub\">Loading…</div>\n          </div>\n          <div class=\"header-actions\">\n            <div class=\"view-toggle\">\n              <button class=\"view-btn active\" id=\"listViewBtn\" onclick=\"setView('list')\">☰</button>\n              <button class=\"view-btn\" id=\"gridViewBtn\" onclick=\"setView('grid')\">⊞</button>\n            </div>\n            <select class=\"sort-select\" onchange=\"doSort(this.value)\">\n              <option value=\"recent\">Sort: Most Recent</option>\n              <option value=\"name\">Sort: Name A–Z</option>\n              <option value=\"versions\">Sort: Most Versions</option>\n              <option value=\"starred\">Sort: Starred First</option>\n            </select>\n          </div>\n        </div>\n        <div class=\"filter-row\">\n          <button class=\"pill active\" onclick=\"filterType('all',this)\">All</button>\n          <button class=\"pill\" onclick=\"filterType('html',this)\">🌐 HTML</button>\n          <button class=\"pill\" onclick=\"filterType('py',this)\">🐍 Python</button>\n          <button class=\"pill\" onclick=\"filterType('xlsx',this)\">📊 Excel</button>\n          <button class=\"pill\" onclick=\"filterType('docx',this)\">📝 Word</button>\n          <button class=\"pill\" onclick=\"filterType('jsx',this)\">⚛ React</button>\n          <button class=\"pill\" onclick=\"filterType('ts',this)\">📘 TS</button>\n          <button class=\"pill\" onclick=\"filterType('js',this)\">📜 JS</button>\n          <button class=\"pill\" onclick=\"filterType('vue',this)\">💚 Vue</button>\n          <button class=\"pill\" onclick=\"filterType('md',this)\">📋 MD</button>\n          <button class=\"pill\" onclick=\"filterType('json',this)\">{ } JSON</button>\n          <button class=\"pill\" onclick=\"filterType('csv',this)\">📈 CSV</button>\n          <button class=\"pill\" onclick=\"filterType('sql',this)\">🗄 SQL</button>\n          <button class=\"pill\" onclick=\"filterType('css',this)\">🎨 CSS</button>\n          <button class=\"pill\" onclick=\"filterType('svg',this)\">🖼 SVG</button>\n          <button class=\"pill\" onclick=\"filterType('pdf',this)\">📕 PDF</button>\n          <button class=\"pill\" onclick=\"filterType('pptx',this)\">📑 PPT</button>\n          <button class=\"pill\" onclick=\"filterType('sh',this)\">⌨ Shell</button>\n          <button class=\"pill\" onclick=\"filterType('yaml',this)\">⚙ YAML</button>\n          <button class=\"pill\" onclick=\"filterType('zip',this)\">📦 Zip</button>\n          <button class=\"pill\" onclick=\"filterType('other',this)\">📄 Other</button>\n        </div>\n      </div>\n\n      <div class=\"artifact-list\" id=\"artifactList\"></div>\n    </div>\n\n    <!-- DETAIL PANEL -->\n    <div class=\"detail-panel\">\n      <div class=\"detail-scroll\">\n\n        <div>\n          <div class=\"detail-section-title\">Workspace Overview</div>\n          <div class=\"stat-grid\" id=\"statsGrid\">\n            <div class=\"stat-box\"><div class=\"stat-num\" id=\"stat-artifacts\">—</div><div class=\"stat-label\">Artifacts</div></div>\n            <div class=\"stat-box\"><div class=\"stat-num\" id=\"stat-versions\">—</div><div class=\"stat-label\">Versions</div></div>\n            <div class=\"stat-box\"><div class=\"stat-num\" style=\"color:var(--amber)\" id=\"stat-starred\">—</div><div class=\"stat-label\">Favourites</div></div>\n            <div class=\"stat-box\"><div class=\"stat-num\" style=\"color:var(--green)\" id=\"stat-folders\">—</div><div class=\"stat-label\">Folders</div></div>\n          </div>\n        </div>\n\n        <div id=\"selectedDetail\">\n          <div class=\"detail-section-title\">Selected Artifact</div>\n          <div style=\"font-size:12px;color:var(--muted);font-style:italic\">Click an artifact card to inspect it</div>\n        </div>\n\n        <div>\n          <div class=\"detail-section-title\">Recent Activity</div>\n          <div id=\"activityFeed\">\n            <div style=\"font-size:12px;color:var(--muted);font-style:italic\">Load your JSON to see activity</div>\n          </div>\n        </div>\n\n      </div>\n    </div>\n\n  </div><!-- workspace-inner -->\n\n</div><!-- workspace -->\n\n<!-- SETTINGS MODAL -->\n<div class=\"modal-overlay\" id=\"settingsModal\">\n  <div class=\"modal modal-wide\">\n    <div class=\"modal-title\">⚙ Settings</div>\n\n    <div class=\"detail-section-title\" style=\"margin-bottom:6px\">GitHub Sync</div>\n    <div id=\"ghStatusPanel\" class=\"gh-status-panel\">\n      <span class=\"gh-dot\" id=\"ghDotModal\"></span>\n      <span id=\"ghStatusPanelText\">Not configured</span>\n    </div>\n    <div class=\"gh-time-row\" id=\"ghTimesRow\" style=\"display:none\">\n      <span id=\"ghLastPushLabel\">—</span>\n      <span id=\"ghLastPullLabel\">—</span>\n    </div>\n\n    <div class=\"modal-field\">\n      <label class=\"modal-label\">GitHub Username</label>\n      <input class=\"modal-input modal-input-mono\" id=\"gh-owner\" placeholder=\"philliprichards26\">\n    </div>\n    <div class=\"modal-field\">\n      <label class=\"modal-label\">Repository Name</label>\n      <input class=\"modal-input modal-input-mono\" id=\"gh-repo\" placeholder=\"artyfarty\">\n    </div>\n    <div class=\"modal-field\">\n      <label class=\"modal-label\">File path in repo</label>\n      <input class=\"modal-input modal-input-mono\" id=\"gh-path\" placeholder=\"artifacts.json\">\n    </div>\n    <div class=\"modal-field\">\n      <label class=\"modal-label\">Personal Access Token (PAT)</label>\n      <input class=\"modal-input modal-input-mono\" id=\"gh-pat\" type=\"password\" placeholder=\"github_pat_...\">\n      <span class=\"modal-hint\">Stored in localStorage only — never sent anywhere except the GitHub API directly.</span>\n    </div>\n\n    <div class=\"modal-actions\">\n      <button class=\"modal-btn modal-btn-danger\" onclick=\"clearGhSettings()\" style=\"margin-right:auto\">Disconnect</button>\n      <button class=\"modal-btn modal-btn-cancel\" onclick=\"closeSettingsModal()\">Cancel</button>\n      <button class=\"modal-btn modal-btn-primary\" onclick=\"saveGhSettings()\">Save &amp; Connect</button>\n    </div>\n  </div>\n</div>\n\n<!-- FOLDER MODAL -->\n<div class=\"modal-overlay\" id=\"folderModal\">\n  <div class=\"modal\">\n    <div class=\"modal-title\" id=\"folderModalTitle\">New Folder</div>\n    <div class=\"modal-field\">\n      <label class=\"modal-label\">Icon</label>\n      <div class=\"modal-emoji-grid\" id=\"folderEmojiGrid\"></div>\n    </div>\n    <div class=\"modal-field\">\n      <label class=\"modal-label\">Name</label>\n      <input class=\"modal-input\" id=\"folderNameInput\" placeholder=\"e.g. My Project\" onkeydown=\"if(event.key==='Enter')saveFolderModal()\">\n    </div>\n    <input type=\"hidden\" id=\"folderModalId\">\n    <input type=\"hidden\" id=\"folderModalParent\">\n    <div class=\"modal-actions\">\n      <button class=\"modal-btn modal-btn-danger\" id=\"folderDeleteBtn\" onclick=\"deleteFolderModal()\" style=\"display:none;margin-right:auto\">🗑 Delete</button>\n      <button class=\"modal-btn modal-btn-cancel\" onclick=\"closeFolderModal()\">Cancel</button>\n      <button class=\"modal-btn modal-btn-primary\" onclick=\"saveFolderModal()\">Save</button>\n    </div>\n  </div>\n</div>\n\n<!-- ARTIFACT MODAL -->\n<div class=\"modal-overlay\" id=\"artifactModal\">\n  <div class=\"modal\" style=\"width:480px;max-height:88vh;overflow-y:auto\">\n    <div class=\"modal-title\" id=\"artifactModalTitle\">New Artifact</div>\n\n    <!-- Attached file indicator -->\n    <div id=\"am-file-banner\" style=\"display:none;align-items:center;gap:10px;padding:10px 12px;background:rgba(63,185,80,.08);border:1px solid var(--green-dim);border-radius:8px\">\n      <span style=\"font-size:18px\">📎</span>\n      <div style=\"flex:1;min-width:0\">\n        <div id=\"am-file-name\" style=\"font-family:'JetBrains Mono',monospace;font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis\"></div>\n        <div id=\"am-file-size\" style=\"font-size:11px;color:var(--muted);margin-top:2px\"></div>\n      </div>\n      <button class=\"modal-btn modal-btn-cancel\" style=\"padding:4px 10px;font-size:11px\" onclick=\"document.getElementById('newArtifactFile').click()\">Replace</button>\n    </div>\n\n    <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:12px\">\n      <div class=\"modal-field\" style=\"grid-column:1/-1\">\n        <label class=\"modal-label\">Name *</label>\n        <input class=\"modal-input\" id=\"am-name\" placeholder=\"e.g. dashboard.html\">\n      </div>\n      <div class=\"modal-field\" style=\"grid-column:1/-1\">\n        <label class=\"modal-label\">Description</label>\n        <input class=\"modal-input\" id=\"am-desc\" placeholder=\"What does it do?\">\n      </div>\n      <div class=\"modal-field\">\n        <label class=\"modal-label\">Folder</label>\n        <select class=\"modal-input\" id=\"am-folder\" style=\"cursor:pointer\"></select>\n      </div>\n      <div class=\"modal-field\">\n        <label class=\"modal-label\">Tags <span style=\"font-weight:400;text-transform:none;letter-spacing:0\">(comma separated)</span></label>\n        <input class=\"modal-input\" id=\"am-tags\" placeholder=\"e.g. mobile, react\">\n      </div>\n      <div class=\"modal-field\">\n        <label class=\"modal-label\">Version</label>\n        <input class=\"modal-input\" id=\"am-ver\" placeholder=\"v1\">\n      </div>\n      <div class=\"modal-field\">\n        <label class=\"modal-label\">Version Note</label>\n        <input class=\"modal-input\" id=\"am-note\" placeholder=\"e.g. initial build\">\n      </div>\n    </div>\n\n    <div style=\"display:flex;align-items:center;gap:10px;padding:10px 12px;background:var(--bg);border:1px solid var(--border);border-radius:8px;cursor:pointer\" onclick=\"toggleAMPref()\">\n      <span style=\"font-size:13px;flex:1\">★ Mark as preferred version</span>\n      <div class=\"tswitch-dark\" id=\"am-pref-switch\"></div>\n    </div>\n\n    <input type=\"hidden\" id=\"am-edit-id\">\n    <input type=\"hidden\" id=\"am-file-content\">\n    <div class=\"modal-actions\">\n      <button class=\"modal-btn modal-btn-danger\" id=\"am-delete-btn\" onclick=\"deleteArtifactModal()\" style=\"display:none;margin-right:auto\">🗑 Delete</button>\n      <button class=\"modal-btn modal-btn-cancel\" onclick=\"closeArtifactModal()\">Cancel</button>\n      <button class=\"modal-btn modal-btn-primary\" onclick=\"saveArtifactModal()\">Save Artifact</button>\n    </div>\n  </div>\n</div>\n\n<!-- CONTEXT MENU -->\n<div class=\"ctx-menu\" id=\"ctxMenu\">\n  <div class=\"ctx-item\" onclick=\"ctxAction('open')\">↗ Open in Claude</div>\n  <div class=\"ctx-item\" onclick=\"ctxAction('edit')\">✏ Edit artifact</div>\n  <div class=\"ctx-item\" onclick=\"ctxAction('copy')\">⧉ Duplicate artifact</div>\n  <div class=\"ctx-item\" onclick=\"ctxAction('move')\">📁 Move to folder…</div>\n  <div class=\"ctx-divider\"></div>\n  <div class=\"ctx-item\" onclick=\"ctxAction('export')\">⬇ Export JSON</div>\n  <div class=\"ctx-divider\"></div>\n  <div class=\"ctx-item danger\" onclick=\"ctxAction('delete')\">🗑 Delete artifact</div>\n</div>\n\n<div class=\"toast\" id=\"toast\"></div>\n\n<script>\n// ── STORAGE KEYS ──────────────────────────────────────────────────────────\nconst LS_ARTIFACTS = 'cam_artifacts';\nconst LS_FOLDERS   = 'cam_folders';\nconst LS_EXPORTED  = 'cam_last_exported'; // timestamp of last export\nconst LS_GH_OWNER  = 'cam_gh_owner';\nconst LS_GH_REPO   = 'cam_gh_repo';\nconst LS_GH_PATH   = 'cam_gh_path';\nconst LS_GH_PAT    = 'cam_gh_pat';\nconst LS_GH_SHA    = 'cam_gh_sha';\nconst LS_GH_PUSHED = 'cam_gh_last_push';\nconst LS_GH_PULLED = 'cam_gh_last_pull';\n\n// ── STATE ─────────────────────────────────────────────────────────────────\nlet ARTIFACTS = [];\nlet FOLDERS = [];\nlet currentView = 'all';\nlet currentFolderId = null;\nlet currentType = 'all';\nlet searchTerm = '';\nlet sortBy = 'recent';\nlet viewMode = 'list';\nlet expandedId = null;\n\n// ── LOCALSTORAGE HELPERS ──────────────────────────────────────────────────\nfunction lsSave() {\n  try {\n    localStorage.setItem(LS_ARTIFACTS, JSON.stringify(ARTIFACTS));\n    localStorage.setItem(LS_FOLDERS,   JSON.stringify(FOLDERS));\n  } catch(e) { console.warn('localStorage save failed', e); }\n}\n\nfunction lsLoad() {\n  try {\n    const arts  = localStorage.getItem(LS_ARTIFACTS);\n    const folds = localStorage.getItem(LS_FOLDERS);\n    if (arts && folds) {\n      ARTIFACTS = JSON.parse(arts);\n      FOLDERS   = JSON.parse(folds);\n      return true;\n    }\n  } catch(e) { console.warn('localStorage load failed', e); }\n  return false;\n}\n\n// ── STARTUP — try localStorage first ─────────────────────────────────────\nwindow.addEventListener('DOMContentLoaded', () => {\n  if (!localStorage.getItem(LS_GH_OWNER)) localStorage.setItem(LS_GH_OWNER, 'philliprichards26');\n  if (!localStorage.getItem(LS_GH_REPO))  localStorage.setItem(LS_GH_REPO,  'artyfarty');\n  if (!localStorage.getItem(LS_GH_PATH))  localStorage.setItem(LS_GH_PATH,  'artifacts.json');\n  updateGhStatusUI();\n  if (lsLoad() && ARTIFACTS.length > 0) {\n    showInterface();\n    showToast('Restored ' + ARTIFACTS.length + ' artifacts from local storage');\n    setTimeout(function() { ghAutoPullOnLoad(); }, 800);\n  }\n  // else load screen stays visible, waiting for JSON drop\n});\n\n// ── FILE LOADING ──────────────────────────────────────────────────────────\nfunction loadFile(input) {\n  const file = input.files[0];\n  if (!file) return;\n  const reader = new FileReader();\n  reader.onload = e => {\n    try {\n      const data = JSON.parse(e.target.result);\n      // If we already have data, treat as merge; otherwise fresh load\n      if (ARTIFACTS.length > 0) {\n        mergeData(data);\n      } else {\n        initData(data);\n      }\n    } catch(err) {\n      showToast('⚠ Invalid JSON file — could not parse');\n    }\n  };\n  reader.readAsText(file);\n  input.value = '';\n}\n\n// Drag & drop\ndocument.addEventListener('dragover', e => e.preventDefault());\ndocument.addEventListener('drop', e => {\n  e.preventDefault();\n  const file = e.dataTransfer.files[0];\n  if (!file || !file.name.endsWith('.json')) { showToast('⚠ Please drop a .json file'); return; }\n  const reader = new FileReader();\n  reader.onload = ev => {\n    try {\n      const data = JSON.parse(ev.target.result);\n      if (ARTIFACTS.length > 0) {\n        mergeData(data);\n      } else {\n        initData(data);\n      }\n    } catch(err) {\n      showToast('⚠ Invalid JSON file — could not parse');\n    }\n  };\n  reader.readAsText(file);\n});\n\n// Fresh load — replaces everything, but never touches the export timestamp\nfunction initData(data) {\n  FOLDERS   = data.folders   || [];\n  ARTIFACTS = data.artifacts || [];\n  lsSave();\n  // Set baseline only if no export timestamp exists yet\n  if (!localStorage.getItem(LS_EXPORTED)) {\n    localStorage.setItem(LS_EXPORTED, new Date().toISOString());\n  }\n  showInterface();\n  showToast(`✦ Loaded ${ARTIFACTS.length} artifacts across ${FOLDERS.length} folders`);\n}\n\n// ── SMART MERGE IMPORT ────────────────────────────────────────────────────\n// Rules:\n//   - Match incoming artifacts by NAME (not id) — ids from different sessions collide\n//   - New artifact (name not in current) → assign a fresh id and add it\n//   - Existing artifact (same name) → merge new versions in (by v tag), never remove\n//   - starred / desc / tags on incoming win only if _updatedAt is newer\n//   - Deletions in the UI are NOT overwritten (absent from JSON ≠ deleted)\n//   - New folders added; existing folders untouched\nfunction mergeData(incoming) {\n  const inFolders   = incoming.folders   || [];\n  const inArtifacts = incoming.artifacts || [];\n\n  // Merge folders — add any new ones by id\n  let foldersAdded = 0;\n  inFolders.forEach(f => {\n    if (!FOLDERS.find(x => x.id === f.id)) {\n      FOLDERS.push(f);\n      foldersAdded++;\n    }\n  });\n\n  // Next safe id = max existing id + 1\n  function nextId() {\n    return ARTIFACTS.length > 0 ? Math.max(...ARTIFACTS.map(a => a.id)) + 1 : 1;\n  }\n\n  // Merge artifacts — match on name, not id\n  let added = 0, versionsAdded = 0, updated = 0;\n  inArtifacts.forEach(inc => {\n    const existing = ARTIFACTS.find(x => x.name === inc.name);\n    if (!existing) {\n      // Brand new — assign a fresh id to avoid collisions\n      const safeId = nextId();\n      ARTIFACTS.push({ ...inc, id: safeId });\n      added++;\n    } else {\n      // Merge versions: add any v tags not already present\n      const existingVTags = new Set(existing.versions.map(v => v.v));\n      (inc.versions || []).forEach(v => {\n        if (!existingVTags.has(v.v)) {\n          existing.versions.push(v);\n          versionsAdded++;\n        }\n      });\n      // Update metadata only if incoming is newer\n      const incUpdated  = inc._updatedAt  || inc.createdAt || 0;\n      const exUpdated   = existing._updatedAt || existing.createdAt || 0;\n      if (incUpdated > exUpdated) {\n        existing.desc    = inc.desc    ?? existing.desc;\n        existing.tags    = inc.tags    ?? existing.tags;\n        existing.starred = inc.starred ?? existing.starred;\n        existing._updatedAt = incUpdated;\n        updated++;\n      }\n    }\n  });\n\n  lsSave();\n  // Set baseline only if no export timestamp exists yet\n  if (!localStorage.getItem(LS_EXPORTED)) {\n    localStorage.setItem(LS_EXPORTED, new Date().toISOString());\n  }\n  buildSidebar();\n  updateStats();\n  buildActivity();\n  render();\n\n  const parts = [];\n  if (added)        parts.push(`${added} new artifact${added!==1?'s':''}`);\n  if (versionsAdded)parts.push(`${versionsAdded} new version${versionsAdded!==1?'s':''}`);\n  if (updated)      parts.push(`${updated} updated`);\n  if (foldersAdded) parts.push(`${foldersAdded} new folder${foldersAdded!==1?'s':''}`);\n  showToast(parts.length ? `✦ Merged: ${parts.join(' · ')}` : '✦ Nothing new to merge');\n}\n\n// ── SHOW INTERFACE ────────────────────────────────────────────────────────\nfunction showInterface() {\n  document.getElementById('loadScreen').style.display = 'none';\n  const mi = document.getElementById('mainInterface');\n  mi.style.display = 'flex';\n  mi.style.flex = '1';\n  mi.style.overflow = 'hidden';\n  document.getElementById('newArtifactBtn').style.display = 'block';\n  buildSidebar();\n  updateStats();\n  buildActivity();\n  selectView('all', document.getElementById('nav-all'));\n}\n\n// ── EXPORT — FULL ─────────────────────────────────────────────────────────\nfunction exportFull() {\n  const now = new Date().toISOString();\n  const data = {\n    exportedAt: now,\n    exportType: 'full',\n    folders:   FOLDERS,\n    artifacts: ARTIFACTS\n  };\n  downloadJSON(data, `artifacts-full-${now.slice(0,10)}.json`);\n  localStorage.setItem(LS_EXPORTED, now);\n  showToast(`⬇ Full export — ${ARTIFACTS.length} artifacts`);\n}\n\n// ── EXPORT — DELTA ────────────────────────────────────────────────────────\n// Only artifacts that changed since last export:\n// changed = createdAt after lastExport, OR any version.savedAt after lastExport,\n//           OR starred toggled (_updatedAt after lastExport), OR file attached\nfunction exportDelta() {\n  const lastExportRaw = localStorage.getItem(LS_EXPORTED);\n  if (!lastExportRaw) {\n    showToast('⚠ No previous export found — run Full Export first');\n    return;\n  }\n  const lastExport = new Date(lastExportRaw).getTime();\n  const now = new Date().toISOString();\n\n  const changed = ARTIFACTS.filter(a => {\n    if ((a.createdAt || 0) > lastExport) return true;\n    if ((a._updatedAt || 0) > lastExport) return true;\n    if (a._attachedFile) return true; // always include if file attached\n    return (a.versions || []).some(v => (v.savedAt || 0) > lastExport);\n  });\n\n  if (!changed.length) {\n    showToast('✦ No changes since last export — nothing to export');\n    return;\n  }\n\n  const data = {\n    exportedAt:    now,\n    exportType:    'delta',\n    deltaFrom:     lastExportRaw,\n    folders:       FOLDERS,\n    artifacts:     changed\n  };\n  downloadJSON(data, `artifacts-delta-${now.slice(0,10)}.json`);\n  localStorage.setItem(LS_EXPORTED, now);\n  showToast(`⬇ Delta export — ${changed.length} changed artifact${changed.length!==1?'s':''}`);\n}\n\nfunction downloadJSON(data, filename) {\n  const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });\n  const url  = URL.createObjectURL(blob);\n  const a    = document.createElement('a');\n  a.href = url; a.download = filename; a.click();\n  URL.revokeObjectURL(url);\n}\n\n// ── TYPE DETECTION ────────────────────────────────────────────────────────\nfunction typeOf(name) {\n  const n = name.toLowerCase();\n  // Web & markup\n  if (n.endsWith('.html') || n.endsWith('.htm') || n.includes('/index.html')) return 'html';\n  if (n.endsWith('.css'))  return 'css';\n  if (n.endsWith('.svg'))  return 'svg';\n  if (n.endsWith('.xml'))  return 'xml';\n  // Scripts & languages\n  if (n.endsWith('.py'))   return 'py';\n  if (n.endsWith('.tsx'))  return 'tsx';\n  if (n.endsWith('.jsx') || n.endsWith('.react')) return 'jsx';\n  if (n.endsWith('.ts'))   return 'ts';\n  if (n.endsWith('.js') || n.endsWith('.mjs')) return 'js';\n  if (n.endsWith('.vue'))  return 'vue';\n  if (n.endsWith('.rb'))   return 'rb';\n  if (n.endsWith('.php'))  return 'php';\n  if (n.endsWith('.java')) return 'java';\n  if (n.endsWith('.rs'))   return 'rs';\n  if (n.endsWith('.go'))   return 'go';\n  if (n.endsWith('.sh') || n.endsWith('.bash') || n.endsWith('.zsh')) return 'sh';\n  // Data & config\n  if (n.endsWith('.sql'))  return 'sql';\n  if (n.endsWith('.json')) return 'json';\n  if (n.endsWith('.csv'))  return 'csv';\n  if (n.endsWith('.yaml') || n.endsWith('.yml')) return 'yaml';\n  if (n.endsWith('.toml')) return 'toml';\n  // Documents\n  if (n.endsWith('.md') || n.endsWith('.mdx')) return 'md';\n  if (n.endsWith('.txt'))  return 'txt';\n  if (n.endsWith('.docx') || n.endsWith('.doc')) return 'docx';\n  if (n.endsWith('.xlsx') || n.endsWith('.xls')) return 'xlsx';\n  if (n.endsWith('.pptx') || n.endsWith('.ppt')) return 'pptx';\n  if (n.endsWith('.pdf'))  return 'pdf';\n  // Archives & media\n  if (n.endsWith('.zip') || n.endsWith('.tar') || n.endsWith('.gz')) return 'zip';\n  if (n.endsWith('.mp4') || n.endsWith('.mov') || n.endsWith('.avi')) return 'mp4';\n  if (n.endsWith('.mp3') || n.endsWith('.wav') || n.endsWith('.ogg')) return 'mp3';\n  return 'other';\n}\n\nconst TYPE_EMOJI = {\n  // Web & markup\n  html:'🌐', css:'🎨', svg:'🖼', xml:'📐',\n  // Scripts & languages\n  py:'🐍', jsx:'⚛', tsx:'⚛', ts:'📘', js:'📜', vue:'💚',\n  rb:'💎', php:'🐘', java:'☕', rs:'🦀', go:'🐹', sh:'⌨',\n  // Data & config\n  sql:'🗄', json:'{}', csv:'📈', yaml:'⚙', toml:'⚙',\n  // Documents\n  md:'📋', txt:'📄', docx:'📝', xlsx:'📊', pptx:'📑', pdf:'📕',\n  // Archives & media\n  zip:'📦', mp4:'🎬', mp3:'🎵',\n  // Fallback\n  other:'📄'\n};\nfunction emojiOf(t) { return TYPE_EMOJI[t] || '📄'; }\n\n// ── FOLDER TREE ───────────────────────────────────────────────────────────\n// Each folder: { id, name, icon, parentId? }\n// collapsed state tracked separately so it survives re-renders\nconst collapsedFolders = new Set();\n\n// Count artifacts in a folder AND all its descendants\nfunction countInFolder(folderId) {\n  const children = FOLDERS.filter(f => f.parentId === folderId);\n  const direct = ARTIFACTS.filter(a => a.folder === folderId).length;\n  return direct + children.reduce((s, c) => s + countInFolder(c.id), 0);\n}\n\n// Render a folder node recursively; returns HTML string\nfunction renderFolderNode(folder, depth) {\n  const children = FOLDERS.filter(f => f.parentId === folder.id);\n  const hasChildren = children.length > 0;\n  const isOpen = !collapsedFolders.has(folder.id);\n  const count = countInFolder(folder.id);\n  const isActive = currentView === 'folder' && currentFolderId === folder.id;\n\n  const toggleClass = hasChildren ? (isOpen ? 'open' : '') : 'leaf';\n\n  const childrenHtml = hasChildren && isOpen\n    ? `<div class=\"folder-children\">${children.map(c => renderFolderNode(c, depth + 1)).join('')}</div>`\n    : '';\n\n  return `\n    <div class=\"folder-tree-item\">\n      <div class=\"folder-row${isActive ? ' active' : ''}\" id=\"fnav-${folder.id}\"\n           onclick=\"selectFolder(${folder.id}, this)\"\n           ondragover=\"onFolderDragOver(event,${folder.id})\"\n           ondragleave=\"onFolderDragLeave(event)\"\n           ondrop=\"onFolderDrop(event,${folder.id})\"\n           ondragstart=\"onFolderDragStart(event,${folder.id})\"\n           draggable=\"true\"\n           >\n        <span class=\"f-toggle ${toggleClass}\"\n              onclick=\"event.stopPropagation(); toggleFolderCollapse(${folder.id})\">▶</span>\n        <span class=\"f-icon\">${folder.icon || '📁'}</span>\n        <span class=\"f-name\">${folder.name}</span>\n        <span class=\"f-count\">${count}</span>\n        <span class=\"folder-actions\">\n          <button class=\"f-act\" title=\"Add subfolder\"\n                  onmousedown=\"event.stopPropagation()\"\n                  onclick=\"event.stopPropagation(); openFolderModal(null, ${folder.id})\">+</button>\n          <button class=\"f-act\" title=\"Rename / edit\"\n                  onmousedown=\"event.stopPropagation()\"\n                  onclick=\"event.stopPropagation(); openFolderModal(${folder.id})\">✏</button>\n        </span>\n      </div>\n      ${childrenHtml}\n    </div>`;\n}\n\nfunction buildSidebar() {\n  // Root folders = no parentId or parentId is null/undefined\n  const roots = FOLDERS.filter(f => !f.parentId);\n  const container = document.getElementById('folderNav');\n  container.innerHTML =\n    roots.map(f => renderFolderNode(f, 0)).join('') +\n    `<div class=\"add-root-folder\" onclick=\"openFolderModal(null, null)\">＋ New folder</div>`;\n\n  document.getElementById('count-all').textContent = ARTIFACTS.length;\n  document.getElementById('count-starred').textContent = ARTIFACTS.filter(a => a.starred).length;\n  document.getElementById('count-recent').textContent = Math.min(ARTIFACTS.length, 8);\n}\n\nfunction toggleFolderCollapse(id) {\n  if (collapsedFolders.has(id)) collapsedFolders.delete(id);\n  else collapsedFolders.add(id);\n  buildSidebar();\n}\n\n// ── FOLDER MODAL ──────────────────────────────────────────────────────────\nconst FOLDER_EMOJIS = ['📁','📂','💼','🚚','🍫','📊','⚖️','📷','⬡','🔧','🎨','📝','🌐','🐍','⚙️','🔬','🎯','💡','🚀','💰','🏗️','📱','📋','🗂️','🗃️','📌','🔑','🧩','⭐','🏷️'];\nlet _folderSelIcon = '📁';\n\nfunction openFolderModal(editId = null, parentId = null) {\n  _folderSelIcon = '📁';\n  const isEdit = editId !== null;\n  const folder = isEdit ? FOLDERS.find(f => f.id === editId) : null;\n\n  document.getElementById('folderModalTitle').textContent = isEdit ? 'Edit Folder' : 'New Folder';\n  document.getElementById('folderModalId').value = editId ?? '';\n  document.getElementById('folderModalParent').value = parentId ?? '';\n  document.getElementById('folderNameInput').value = isEdit ? folder.name : '';\n  document.getElementById('folderDeleteBtn').style.display = isEdit ? 'block' : 'none';\n\n  if (isEdit && folder) _folderSelIcon = folder.icon || '📁';\n\n  // Build emoji grid\n  document.getElementById('folderEmojiGrid').innerHTML = FOLDER_EMOJIS.map(e =>\n    `<button class=\"modal-emoji${e === _folderSelIcon ? ' sel' : ''}\"\n             onclick=\"selectFolderEmoji('${e}', this)\">${e}</button>`\n  ).join('');\n\n  document.getElementById('folderModal').classList.add('show');\n  setTimeout(() => document.getElementById('folderNameInput').focus(), 50);\n}\n\nfunction selectFolderEmoji(emoji, btn) {\n  _folderSelIcon = emoji;\n  document.querySelectorAll('.modal-emoji').forEach(b => b.classList.remove('sel'));\n  btn.classList.add('sel');\n}\n\nfunction closeFolderModal() {\n  document.getElementById('folderModal').classList.remove('show');\n}\n\nfunction saveFolderModal() {\n  const name = document.getElementById('folderNameInput').value.trim();\n  if (!name) { showToast('⚠ Folder name required'); return; }\n  const editId = document.getElementById('folderModalId').value;\n  const parentRaw = document.getElementById('folderModalParent').value;\n  const parentId = parentRaw !== '' ? parseInt(parentRaw) : null;\n\n  if (editId) {\n    // Rename/edit existing\n    const f = FOLDERS.find(x => x.id === parseInt(editId));\n    if (f) { f.name = name; f.icon = _folderSelIcon; }\n    showToast(`✦ \"${name}\" updated`);\n  } else {\n    // Create new\n    const newId = Math.max(0, ...FOLDERS.map(f => f.id)) + 1;\n    FOLDERS.push({ id: newId, name, icon: _folderSelIcon, parentId });\n    showToast(`✦ \"${name}\" created`);\n  }\n\n  lsSave();\n  closeFolderModal();\n  buildSidebar();\n  updateStats();\n}\n\nfunction deleteFolderModal() {\n  const editId = parseInt(document.getElementById('folderModalId').value);\n  const folder = FOLDERS.find(f => f.id === editId);\n  if (!folder) return;\n\n  // Check for artifacts or child folders\n  const hasArtifacts = ARTIFACTS.some(a => a.folder === editId);\n  const hasChildren = FOLDERS.some(f => f.parentId === editId);\n  if (hasArtifacts || hasChildren) {\n    showToast('⚠ Move artifacts and subfolders out first');\n    return;\n  }\n\n  if (!confirm(`Delete \"${folder.name}\"? This cannot be undone.`)) return;\n  FOLDERS = FOLDERS.filter(f => f.id !== editId);\n  lsSave();\n  closeFolderModal();\n  if (currentFolderId === editId) selectView('all', document.getElementById('nav-all'));\n  else buildSidebar();\n  showToast(`🗑 \"${folder.name}\" deleted`);\n}\n\n// ── STATS ─────────────────────────────────────────────────────────────────\nfunction updateStats() {\n  const totalVersions = ARTIFACTS.reduce((s,a)=>s+a.versions.length,0);\n  const starred = ARTIFACTS.filter(a=>a.starred).length;\n  document.getElementById('stat-artifacts').textContent = ARTIFACTS.length;\n  document.getElementById('stat-versions').textContent = totalVersions;\n  document.getElementById('stat-starred').textContent = starred;\n  document.getElementById('stat-folders').textContent = FOLDERS.length;\n  document.getElementById('storageLabel').textContent = `${ARTIFACTS.length} artifacts · ${totalVersions} versions`;\n  const pct = Math.min(100, Math.round((totalVersions / 200) * 100));\n  document.getElementById('storageBar').style.width = pct + '%';\n  const lastExp = localStorage.getItem(LS_EXPORTED);\n  document.getElementById('storageDate').textContent = lastExp\n    ? `Last export: ${new Date(lastExp).toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'2-digit'})}`\n    : 'Not yet exported';\n}\n\nfunction clearStorage() {\n  if (!confirm('Clear all locally stored data? You will need to reload your JSON.')) return;\n  localStorage.removeItem(LS_ARTIFACTS);\n  localStorage.removeItem(LS_FOLDERS);\n  localStorage.removeItem(LS_EXPORTED);\n  ARTIFACTS = []; FOLDERS = [];\n  document.getElementById('mainInterface').style.display = 'none';\n  document.getElementById('loadScreen').style.display = 'flex';\n  showToast('✦ Local storage cleared');\n}\n\n// ── ACTIVITY FEED ─────────────────────────────────────────────────────────\nfunction buildActivity() {\n  const feed = document.getElementById('activityFeed');\n  const colors = ['var(--green)','var(--amber)','var(--blue)','var(--purple)','var(--cyan)','var(--red)'];\n  // Most recently created artifacts\n  const recent = ARTIFACTS.slice().sort((a,b)=>b.createdAt-a.createdAt).slice(0,8);\n  feed.innerHTML = recent.map((a,i) => {\n    const preferred = a.versions.find(v=>v.preferred);\n    const label = preferred ? `preferred: \"${preferred.note}\"` : `${a.versions.length} version${a.versions.length!==1?'s':''}`;\n    const folder = FOLDERS.find(f=>f.id===a.folder);\n    return `<div class=\"activity-item\"><div class=\"activity-dot\" style=\"background:${colors[i%colors.length]}\"></div>${a.name} — ${label}${folder?' · '+folder.icon:''}</div>`;\n  }).join('');\n}\n\n// ── RENDER ────────────────────────────────────────────────────────────────\nfunction getFiltered() {\n  let list = [...ARTIFACTS];\n\n  // View filter\n  if (currentView === 'starred') list = list.filter(a=>a.starred);\n  else if (currentView === 'recent') list = list.slice().sort((a,b)=>b.createdAt-a.createdAt).slice(0,8);\n  else if (currentView === 'folder' && currentFolderId !== null) list = list.filter(a=>a.folder===currentFolderId);\n\n  // Type filter\n  if (currentType !== 'all') list = list.filter(a=>typeOf(a.name)===currentType);\n\n  // Search\n  if (searchTerm) {\n    const s = searchTerm.toLowerCase();\n    list = list.filter(a =>\n      a.name.toLowerCase().includes(s) ||\n      (a.desc||'').toLowerCase().includes(s) ||\n      (a.tags||[]).some(t=>t.toLowerCase().includes(s)) ||\n      a.versions.some(v=>(v.note||'').toLowerCase().includes(s))\n    );\n  }\n\n  // Sort\n  if (sortBy === 'name') list.sort((a,b)=>a.name.localeCompare(b.name));\n  else if (sortBy === 'versions') list.sort((a,b)=>b.versions.length-a.versions.length);\n  else if (sortBy === 'starred') list.sort((a,b)=>(b.starred?1:0)-(a.starred?1:0));\n  else list.sort((a,b)=>b.createdAt-a.createdAt);\n\n  return list;\n}\n\nfunction render() {\n  const list = getFiltered();\n  const container = document.getElementById('artifactList');\n  container.className = 'artifact-list' + (viewMode==='grid'?' grid-view':'');\n\n  if (!list.length) {\n    container.innerHTML = `<div class=\"empty-state\"><div class=\"empty-icon\">⬡</div>No artifacts match this filter</div>`;\n    return;\n  }\n\n  const folder = FOLDERS.find(f=>f.id===currentFolderId);\n  document.getElementById('viewSub').textContent = `${list.length} artifact${list.length!==1?'s':''} · ${folder?folder.name+' · ':''}Personal workspace`;\n\n  container.innerHTML = list.map(a => {\n    const type = typeOf(a.name);\n    const emoji = emojiOf(type);\n    const preferred = a.versions.find(v=>v.preferred);\n    const isExpanded = expandedId === a.id;\n    const f = FOLDERS.find(f=>f.id===a.folder);\n    const tagsHtml = (a.tags||[]).slice(0,3).map(t=>`<span class=\"tag\">${t}</span>`).join('');\n\n    const versionsHtml = a.versions.map(v => `\n      <div class=\"version-row\">\n        <div class=\"version-tag${v.preferred?' preferred':''}\">${v.v}</div>\n        ${v.preferred ? '<span class=\"preferred-badge\">★ preferred</span>' : ''}\n        <div class=\"version-note\">${v.note||''}</div>\n        <div class=\"version-date\">${formatDate(v.savedAt)}</div>\n        <button class=\"version-star${v.preferred?' starred':''}\" onclick=\"event.stopPropagation();showToast('Version ${v.v} marked as preferred')\" title=\"Mark preferred\">★</button>\n      </div>\n    `).join('');\n\n    return `\n    <div class=\"artifact-card${isExpanded?' expanded':''}\" id=\"card-${a.id}\"\n         draggable=\"true\"\n         ondragstart=\"onArtifactDragStart(event,${a.id})\"\n         ondragend=\"onDragEnd(event)\"\n         oncontextmenu=\"showCtx(event,${a.id})\">\n      <div class=\"card-main\" onclick=\"toggleCard(${a.id})\">\n        <span class=\"drag-handle\" title=\"Drag to move folder\">⠿</span>\n        <div class=\"type-badge type-${type}\">${emoji}</div>\n        <div class=\"card-info\">\n          <span class=\"card-name\">${a.name}</span>\n          <div class=\"card-desc\">${a.desc||''}</div>\n          <div class=\"card-meta\">\n            ${f?`<span style=\"font-size:10px\">${f.icon} ${f.name}</span>`:''} \n            <div class=\"card-tags\">${tagsHtml}</div>\n          </div>\n        </div>\n        <div class=\"card-right\">\n          <span class=\"version-count\">${a.versions.length}v${preferred?` ★`:''}</span>\n          <button class=\"star-btn${a.starred?' starred':''}\" onclick=\"event.stopPropagation();toggleStar(${a.id})\">${a.starred?'★':'☆'}</button>\n          <span class=\"expand-icon\">▾</span>\n        </div>\n      </div>\n      <div class=\"version-drawer${isExpanded?' open':''}\">\n        <div class=\"drawer-header\">Version History${preferred?` · <span style=\"color:var(--amber)\">★ ${preferred.v} preferred</span>`:''}\n        </div>\n        ${versionsHtml}\n        <div class=\"card-action-row\">\n          <button class=\"act-btn${a._attachedFile?' attach-ok':''}\" onclick=\"event.stopPropagation();triggerAttach(${a.id})\" title=\"Attach the actual file to this artifact\">📎 ${a._attachedFile?'Re-attach':'Attach'}</button>\n          ${a._attachedFile?`<button class=\"act-btn\" onclick=\"event.stopPropagation();downloadAttached(${a.id})\" title=\"Download attached file\">⬇ Download</button>`:''}\n          <button class=\"act-btn\" onclick=\"event.stopPropagation();toggleRebuild(${a.id})\" title=\"Generate a rebuild prompt to paste into Claude\">🤖 Rebuild</button>\n        </div>\n        <input type=\"file\" id=\"attach-${a.id}\" style=\"display:none\" onchange=\"attachFile(${a.id},this)\">\n        <div class=\"rebuild-box\" id=\"rebuild-${a.id}\">\n          <div class=\"rebuild-title\">📋 Paste this into Claude to rebuild:</div>\n          <div class=\"rebuild-prompt\" id=\"rebuild-text-${a.id}\">${buildRebuildPrompt(a)}</div>\n          <button class=\"copy-btn\" onclick=\"copyRebuild(${a.id})\">📋 Copy Prompt</button>\n        </div>\n      </div>\n    </div>`;\n  }).join('');\n}\n\nfunction formatDate(ts) {\n  if (!ts) return '—';\n  const d = new Date(ts);\n  return d.toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'2-digit'});\n}\n\n// ── INTERACTIONS ──────────────────────────────────────────────────────────\nfunction toggleCard(id) {\n  expandedId = expandedId === id ? null : id;\n  const a = ARTIFACTS.find(x=>x.id===id);\n  render();\n  if (a) updateDetail(a);\n}\n\nfunction toggleStar(id) {\n  const a = ARTIFACTS.find(x=>x.id===id);\n  if (!a) return;\n  a.starred = !a.starred;\n  a._updatedAt = Date.now();\n  lsSave();\n  showToast(a.starred ? `★ ${a.name} added to favourites` : `${a.name} removed from favourites`);\n  document.getElementById('count-starred').textContent = ARTIFACTS.filter(a=>a.starred).length;\n  document.getElementById('stat-starred').textContent = ARTIFACTS.filter(a=>a.starred).length;\n  render();\n}\n\nfunction selectView(view, el) {\n  currentView = view;\n  currentFolderId = null;\n  expandedId = null;\n  document.querySelectorAll('.nav-item,.starred-nav,.folder-row').forEach(e=>e.classList.remove('active'));\n  if (el) el.classList.add('active');\n  const titles = { all:'All Artifacts', starred:'Favourites', recent:'Recent' };\n  document.getElementById('viewTitle').textContent = titles[view] || view;\n  render();\n}\n\nfunction selectFolder(folderId, el) {\n  currentView = 'folder';\n  currentFolderId = folderId;\n  expandedId = null;\n  document.querySelectorAll('.nav-item,.starred-nav,.folder-row').forEach(e => e.classList.remove('active'));\n  // Mark the clicked row active (el may be the row itself or a child)\n  const row = document.getElementById('fnav-' + folderId);\n  if (row) row.classList.add('active');\n  const f = FOLDERS.find(f => f.id === folderId);\n  document.getElementById('viewTitle').textContent = f ? `${f.icon} ${f.name}` : 'Folder';\n  render();\n}\n\nfunction filterType(type, el) {\n  currentType = type;\n  document.querySelectorAll('.pill').forEach(p=>p.classList.remove('active'));\n  el.classList.add('active');\n  expandedId = null;\n  render();\n}\n\nfunction doSearch() {\n  searchTerm = document.getElementById('searchInput').value;\n  expandedId = null;\n  render();\n}\n\nfunction doSort(val) { sortBy = val; render(); }\n\nfunction setView(mode) {\n  viewMode = mode;\n  document.getElementById('listViewBtn').classList.toggle('active', mode==='list');\n  document.getElementById('gridViewBtn').classList.toggle('active', mode==='grid');\n  expandedId = null;\n  render();\n}\n\nfunction updateDetail(a) {\n  const type = typeOf(a.name);\n  const preferred = a.versions.find(v=>v.preferred);\n  const folder = FOLDERS.find(f=>f.id===a.folder);\n  document.getElementById('selectedDetail').innerHTML = `\n    <div class=\"detail-section-title\">${emojiOf(type)} Selected</div>\n    <div class=\"detail-row\">\n      <div class=\"detail-label\">Name</div>\n      <div class=\"detail-value mono\">${a.name}</div>\n    </div>\n    <div class=\"detail-row\">\n      <div class=\"detail-label\">Description</div>\n      <div class=\"detail-value\" style=\"font-size:12px\">${a.desc||'—'}</div>\n    </div>\n    <div class=\"detail-row\">\n      <div class=\"detail-label\">Folder</div>\n      <div class=\"detail-value\">${folder?`${folder.icon} ${folder.name}`:'—'}</div>\n    </div>\n    <div class=\"detail-row\">\n      <div class=\"detail-label\">Versions</div>\n      <div class=\"detail-value\">${a.versions.length} tracked</div>\n    </div>\n    <div class=\"detail-row\">\n      <div class=\"detail-label\">Preferred</div>\n      <div class=\"detail-value\" style=\"color:var(--amber)\">${preferred?`★ ${preferred.v} — \"${preferred.note}\"`:'None set'}</div>\n    </div>\n    <div class=\"detail-row\">\n      <div class=\"detail-label\">Tags</div>\n      <div style=\"display:flex;gap:3px;flex-wrap:wrap;margin-top:2px\">${(a.tags||[]).map(t=>`<span class=\"tag\">${t}</span>`).join('')}</div>\n    </div>\n    <div class=\"detail-row\">\n      <div class=\"detail-label\">Created</div>\n      <div class=\"detail-value\">${formatDate(a.createdAt)}</div>\n    </div>\n  `;\n}\n\n// CONTEXT MENU\nlet ctxTarget = null;\nfunction showCtx(e, id) {\n  e.preventDefault();\n  ctxTarget = id;\n  const m = document.getElementById('ctxMenu');\n  m.style.left = Math.min(e.clientX, window.innerWidth-180)+'px';\n  m.style.top = Math.min(e.clientY, window.innerHeight-160)+'px';\n  m.classList.add('show');\n}\nfunction ctxAction(action) {\n  const a = ARTIFACTS.find(x=>x.id===ctxTarget);\n  if (action === 'edit') { document.getElementById('ctxMenu').classList.remove('show'); openArtifactModal(ctxTarget); return; }\n  if (action === 'delete') { document.getElementById('ctxMenu').classList.remove('show'); if(a && confirm(`Delete \"${a.name}\"?`)){ARTIFACTS=ARTIFACTS.filter(x=>x.id!==ctxTarget);lsSave();buildSidebar();updateStats();render();showToast(`🗑 \"${a.name}\" deleted`);} return; }\n  const msgs = {\n    open:`Opening source conversation for ${a?.name}…`,\n    copy:`Duplicating ${a?.name}…`,\n    move: `Drag the card to a folder in the sidebar to move it`,\n    export:`Exporting ${a?.name}…`,\n  };\n  showToast('✦ ' + (msgs[action]||action));\n  document.getElementById('ctxMenu').classList.remove('show');\n}\n// Folder modal closes via Cancel/Save only (click-outside removed to prevent accidental close)\ndocument.addEventListener('click', ()=>document.getElementById('ctxMenu').classList.remove('show'));\n\n// ── ATTACH ────────────────────────────────────────────────────────────────\nfunction triggerAttach(id) {\n  const inp = document.getElementById('attach-' + id);\n  if (inp) inp.click();\n}\n\nfunction attachFile(artId, input) {\n  const file = input.files[0];\n  if (!file) return;\n  const reader = new FileReader();\n  reader.onload = e => {\n    const a = ARTIFACTS.find(x => x.id === artId);\n    if (!a) return;\n    a._attachedFile = { name: file.name, size: file.size, content: e.target.result, type: file.type };\n    a._updatedAt = Date.now();\n    const pref = a.versions.find(v => v.preferred) || a.versions[a.versions.length - 1];\n    if (pref) { pref._fileName = file.name; pref._fileSize = file.size; }\n    lsSave();\n    showToast(`📎 \"${file.name}\" attached to ${a.name}`);\n    render();\n  };\n  reader.readAsText(file);\n  input.value = '';\n}\n\nfunction downloadAttached(artId) {\n  const a = ARTIFACTS.find(x => x.id === artId);\n  if (!a || !a._attachedFile) { showToast('No file attached'); return; }\n  const blob = new Blob([a._attachedFile.content], { type: 'text/plain' });\n  const url = URL.createObjectURL(blob);\n  const link = document.createElement('a');\n  link.href = url; link.download = a._attachedFile.name; link.click();\n  URL.revokeObjectURL(url);\n  showToast(`⬇ Downloading ${a._attachedFile.name}`);\n}\n\n// ── REBUILD ───────────────────────────────────────────────────────────────\nfunction buildRebuildPrompt(a) {\n  const pref = (a.versions || []).find(v => v.preferred) || a.versions?.[a.versions.length - 1];\n  const ver = pref ? pref.v : 'latest version';\n  const note = pref?.note ? ` (${pref.note})` : '';\n  const desc = a.desc ? ` ${a.desc}` : '';\n  return `Please re-send or rebuild \"${a.name}\" — ${ver}${note}.${desc}`.trim();\n}\n\nfunction toggleRebuild(id) {\n  const box = document.getElementById('rebuild-' + id);\n  if (!box) return;\n  // Update the prompt text in case versions changed\n  const a = ARTIFACTS.find(x => x.id === id);\n  if (a) {\n    const textEl = document.getElementById('rebuild-text-' + id);\n    if (textEl) textEl.textContent = buildRebuildPrompt(a);\n  }\n  box.classList.toggle('show');\n}\n\nfunction copyRebuild(id) {\n  const a = ARTIFACTS.find(x => x.id === id);\n  if (!a) return;\n  const prompt = buildRebuildPrompt(a);\n  if (navigator.clipboard) {\n    navigator.clipboard.writeText(prompt)\n      .then(() => showToast('📋 Prompt copied — paste into Claude!'))\n      .catch(() => fallbackCopy(prompt));\n  } else { fallbackCopy(prompt); }\n}\n\nfunction fallbackCopy(text) {\n  const ta = document.createElement('textarea');\n  ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';\n  document.body.appendChild(ta); ta.select();\n  try { document.execCommand('copy'); showToast('📋 Copied!'); }\n  catch { showToast('⚠ Copy manually from the box'); }\n  document.body.removeChild(ta);\n}\n\n// ── ARTIFACT MODAL ────────────────────────────────────────────────────────\nlet _amPref = false;\nlet _amFileContent = '';\nlet _amFileName = '';\nlet _amFileSize = 0;\n\nfunction formatBytes(b) {\n  if (b < 1024) return b + ' B';\n  if (b < 1024*1024) return (b/1024).toFixed(1) + ' KB';\n  return (b/1024/1024).toFixed(1) + ' MB';\n}\n\n// Called when user picks a file via + New button\nfunction onNewArtifactFile(input) {\n  const file = input.files[0];\n  if (!file) return;\n  const reader = new FileReader();\n  reader.onload = e => {\n    _amFileContent = e.target.result;\n    _amFileName    = file.name;\n    _amFileSize    = file.size;\n    openArtifactModal(null); // open modal pre-filled with file info\n  };\n  reader.readAsText(file);\n  input.value = ''; // reset so same file can be picked again\n}\n\nfunction buildFolderOptions(selectEl, selectedId) {\n  function collectOptions(parentId, depth) {\n    return FOLDERS.filter(f => (f.parentId || null) === (parentId || null)).flatMap(f => {\n      const indent = '　'.repeat(depth);\n      const opt = document.createElement('option');\n      opt.value = f.id;\n      opt.textContent = indent + f.icon + ' ' + f.name;\n      if (f.id === selectedId) opt.selected = true;\n      return [opt, ...collectOptions(f.id, depth + 1)];\n    });\n  }\n  selectEl.innerHTML = '<option value=\"\">— No folder —</option>';\n  collectOptions(null, 0).forEach(o => selectEl.appendChild(o));\n}\n\nfunction toggleAMPref() {\n  _amPref = !_amPref;\n  document.getElementById('am-pref-switch').classList.toggle('on', _amPref);\n}\n\nfunction openArtifactModal(editId = null) {\n  _amPref = false;\n  document.getElementById('am-pref-switch').classList.remove('on');\n  document.getElementById('am-edit-id').value = editId ?? '';\n  document.getElementById('am-delete-btn').style.display = editId ? 'block' : 'none';\n  document.getElementById('artifactModalTitle').textContent = editId ? 'Edit Artifact' : 'New Artifact';\n\n  const banner = document.getElementById('am-file-banner');\n\n  if (editId) {\n    // Edit mode — load existing artifact data, no file pre-fill\n    _amFileContent = '';\n    _amFileName = '';\n    _amFileSize = 0;\n    banner.style.display = 'none';\n\n    const a = ARTIFACTS.find(x => x.id === editId);\n    if (!a) return;\n    document.getElementById('am-name').value = a.name;\n    document.getElementById('am-desc').value = a.desc || '';\n    document.getElementById('am-tags').value = (a.tags || []).join(', ');\n    const pref = a.versions.find(v => v.preferred) || a.versions[a.versions.length - 1];\n    document.getElementById('am-ver').value  = pref ? pref.v : 'v1';\n    document.getElementById('am-note').value = pref ? pref.note : '';\n    _amPref = !!pref?.preferred;\n    document.getElementById('am-pref-switch').classList.toggle('on', _amPref);\n    buildFolderOptions(document.getElementById('am-folder'), a.folder);\n\n    // Show existing attachment if present\n    if (a._attachedFile) {\n      _amFileContent = a._attachedFile.content;\n      _amFileName    = a._attachedFile.name;\n      _amFileSize    = a._attachedFile.size;\n      document.getElementById('am-file-name').textContent = _amFileName;\n      document.getElementById('am-file-size').textContent = formatBytes(_amFileSize) + ' · attached';\n      banner.style.display = 'flex';\n    }\n  } else {\n    // New artifact — pre-fill from file if one was picked\n    document.getElementById('am-desc').value  = '';\n    document.getElementById('am-tags').value  = '';\n    document.getElementById('am-ver').value   = 'v1';\n    document.getElementById('am-note').value  = 'Initial import';\n    buildFolderOptions(document.getElementById('am-folder'), currentFolderId);\n\n    if (_amFileName) {\n      document.getElementById('am-name').value = _amFileName;\n      document.getElementById('am-file-name').textContent = _amFileName;\n      document.getElementById('am-file-size').textContent = formatBytes(_amFileSize);\n      banner.style.display = 'flex';\n    } else {\n      document.getElementById('am-name').value = '';\n      banner.style.display = 'none';\n    }\n  }\n\n  document.getElementById('artifactModal').classList.add('show');\n  // Focus description if name is already filled (file import), otherwise name\n  const focusTarget = _amFileName && !editId ? 'am-desc' : 'am-name';\n  setTimeout(() => document.getElementById(focusTarget).focus(), 50);\n}\n\nfunction closeArtifactModal() {\n  document.getElementById('artifactModal').classList.remove('show');\n  _amFileContent = '';\n  _amFileName = '';\n  _amFileSize = 0;\n}\n\nfunction saveArtifactModal() {\n  const name = document.getElementById('am-name').value.trim();\n  if (!name) { showToast('⚠ Name is required'); return; }\n\n  const desc      = document.getElementById('am-desc').value.trim();\n  const tagsRaw   = document.getElementById('am-tags').value.trim();\n  const tags      = tagsRaw ? tagsRaw.split(',').map(t => t.trim().toLowerCase()).filter(Boolean) : [];\n  const ver       = document.getElementById('am-ver').value.trim() || 'v1';\n  const note      = document.getElementById('am-note').value.trim() || 'Initial import';\n  const folderRaw = document.getElementById('am-folder').value;\n  const folder    = folderRaw ? parseInt(folderRaw) : null;\n  const editId    = document.getElementById('am-edit-id').value;\n  const now       = Date.now();\n\n  if (editId) {\n    const a = ARTIFACTS.find(x => x.id === parseInt(editId));\n    if (!a) return;\n    a.name = name;\n    a.desc = desc;\n    a.tags = tags;\n    a.folder = folder;\n    a._updatedAt = now;\n    // Update file attachment if a new one was picked\n    if (_amFileContent) {\n      a._attachedFile = { name: _amFileName, size: _amFileSize, content: _amFileContent };\n      const pref = a.versions.find(v => v.preferred) || a.versions[a.versions.length - 1];\n      if (pref) { pref._fileName = _amFileName; pref.note = note; }\n    }\n    showToast(`✦ \"${name}\" updated`);\n  } else {\n    const newId = ARTIFACTS.length > 0 ? Math.max(...ARTIFACTS.map(a => a.id)) + 1 : 1;\n    const version = { v: ver, note, savedAt: now, preferred: _amPref };\n    if (_amFileContent) {\n      version._fileName = _amFileName;\n      version._fileSize = _amFileSize;\n    }\n    const artifact = {\n      id: newId, name, desc, folder, tags,\n      starred: false, createdAt: now, _updatedAt: now,\n      versions: [version]\n    };\n    // Attach file content directly if imported\n    if (_amFileContent) {\n      artifact._attachedFile = { name: _amFileName, size: _amFileSize, content: _amFileContent };\n    }\n    ARTIFACTS.push(artifact);\n    showToast(`✦ \"${name}\" imported`);\n  }\n\n  lsSave();\n  closeArtifactModal();\n  buildSidebar();\n  updateStats();\n  buildActivity();\n  render();\n}\n\nfunction deleteArtifactModal() {\n  const editId = parseInt(document.getElementById('am-edit-id').value);\n  const a = ARTIFACTS.find(x => x.id === editId);\n  if (!a) return;\n  if (!confirm(`Delete \"${a.name}\"? This cannot be undone.`)) return;\n  ARTIFACTS = ARTIFACTS.filter(x => x.id !== editId);\n  lsSave();\n  closeArtifactModal();\n  buildSidebar();\n  updateStats();\n  render();\n  showToast(`🗑 \"${a.name}\" deleted`);\n}\n\n// Close artifact modal on overlay click\ndocument.getElementById('artifactModal').addEventListener('click', e => {\n  if (e.target === document.getElementById('artifactModal')) closeArtifactModal();\n});\n\n// ── DRAG AND DROP ─────────────────────────────────────────────────────────\nlet dragType   = null;  // 'artifact' | 'folder'\nlet dragArtId  = null;\nlet dragFoldId = null;\nlet lastDropTarget = null;\n\n// ── Artifact dragging ─────────────────────────────────────────────────────\nfunction onArtifactDragStart(e, artId) {\n  dragType  = 'artifact';\n  dragArtId = artId;\n  dragFoldId = null;\n  e.dataTransfer.effectAllowed = 'move';\n  e.dataTransfer.setData('text/plain', 'artifact:' + artId);\n  // Slight delay so the card doesn't go transparent before ghost forms\n  setTimeout(() => {\n    const el = document.getElementById('card-' + artId);\n    if (el) el.classList.add('dragging');\n  }, 0);\n}\n\n// ── Folder dragging ───────────────────────────────────────────────────────\nfunction onFolderDragStart(e, folderId) {\n  dragType   = 'folder';\n  dragFoldId = folderId;\n  dragArtId  = null;\n  e.dataTransfer.effectAllowed = 'move';\n  e.dataTransfer.setData('text/plain', 'folder:' + folderId);\n  e.stopPropagation(); // don't bubble to parent folder rows\n}\n\n// ── Is folderId a descendant of ancestorId? (circular ref guard) ──────────\nfunction isFolderDescendant(folderId, ancestorId) {\n  if (folderId === ancestorId) return true;\n  const children = FOLDERS.filter(f => f.parentId === ancestorId);\n  return children.some(c => isFolderDescendant(folderId, c.id));\n}\n\n// ── Shared drag-over for folder rows ─────────────────────────────────────\nfunction onFolderDragOver(e, targetFolderId) {\n  e.preventDefault();\n  e.stopPropagation();\n\n  // Clear previous highlight\n  if (lastDropTarget && lastDropTarget !== targetFolderId) {\n    const prev = document.getElementById('fnav-' + lastDropTarget);\n    if (prev) { prev.classList.remove('drop-target','drop-forbidden'); }\n  }\n  lastDropTarget = targetFolderId;\n  const row = document.getElementById('fnav-' + targetFolderId);\n  if (!row) return;\n\n  if (dragType === 'artifact') {\n    // Always valid to drop artifact onto any folder\n    e.dataTransfer.dropEffect = 'move';\n    row.classList.add('drop-target');\n    row.classList.remove('drop-forbidden');\n  } else if (dragType === 'folder') {\n    // Invalid: dropping onto itself or a descendant\n    const forbidden = dragFoldId === targetFolderId\n                   || isFolderDescendant(targetFolderId, dragFoldId);\n    if (forbidden) {\n      e.dataTransfer.dropEffect = 'none';\n      row.classList.add('drop-forbidden');\n      row.classList.remove('drop-target');\n    } else {\n      e.dataTransfer.dropEffect = 'move';\n      row.classList.add('drop-target');\n      row.classList.remove('drop-forbidden');\n    }\n  }\n}\n\nfunction onFolderDragLeave(e) {\n  // Only clear if leaving the row entirely (not entering a child element)\n  const row = e.currentTarget;\n  if (!row.contains(e.relatedTarget)) {\n    row.classList.remove('drop-target','drop-forbidden');\n  }\n}\n\n// ── Drop onto folder row ──────────────────────────────────────────────────\nfunction onFolderDrop(e, targetFolderId) {\n  e.preventDefault();\n  e.stopPropagation();\n\n  const row = document.getElementById('fnav-' + targetFolderId);\n  if (row) row.classList.remove('drop-target','drop-forbidden');\n  lastDropTarget = null;\n\n  if (dragType === 'artifact' && dragArtId !== null) {\n    // Move artifact to target folder\n    const a = ARTIFACTS.find(x => x.id === dragArtId);\n    if (!a) return;\n    const oldFolder = FOLDERS.find(f => f.id === a.folder);\n    const newFolder = FOLDERS.find(f => f.id === targetFolderId);\n    if (a.folder === targetFolderId) { showToast('Already in that folder'); return; }\n    a.folder = targetFolderId;\n    a._updatedAt = Date.now();\n    lsSave();\n    buildSidebar();\n    render();\n    showToast(`✦ Moved to ${newFolder ? newFolder.icon + ' ' + newFolder.name : 'folder'}`);\n\n  } else if (dragType === 'folder' && dragFoldId !== null) {\n    // Nest folder under target folder\n    if (dragFoldId === targetFolderId) return;\n    if (isFolderDescendant(targetFolderId, dragFoldId)) {\n      showToast('⚠ Cannot nest a folder inside its own descendant');\n      return;\n    }\n    const f = FOLDERS.find(x => x.id === dragFoldId);\n    const target = FOLDERS.find(x => x.id === targetFolderId);\n    if (!f) return;\n    f.parentId = targetFolderId;\n    // Make sure target is expanded so you can see the result\n    collapsedFolders.delete(targetFolderId);\n    lsSave();\n    buildSidebar();\n    showToast(`✦ ${f.icon} ${f.name} moved into ${target ? target.icon + ' ' + target.name : 'folder'}`);\n  }\n\n  dragType = dragArtId = dragFoldId = null;\n}\n\nfunction onDragEnd(e) {\n  // Clean up dragging class if drop happened outside a valid target\n  if (dragArtId !== null) {\n    const el = document.getElementById('card-' + dragArtId);\n    if (el) el.classList.remove('dragging');\n  }\n  // Clear any stray highlights\n  document.querySelectorAll('.drop-target,.drop-forbidden').forEach(el => {\n    el.classList.remove('drop-target','drop-forbidden');\n  });\n  dragType = dragArtId = dragFoldId = null;\n}\n\n// ── TOAST ─────────────────────────────────────────────────────────────────\nlet toastTimer;\nfunction showToast(msg) {\n  const t = document.getElementById('toast');\n  t.innerHTML = msg.startsWith('✦') ? msg : '✦ ' + msg;\n  t.classList.add('show');\n  clearTimeout(toastTimer);\n  toastTimer = setTimeout(()=>t.classList.remove('show'), 2400);\n}\n\n// ── GITHUB SYNC ───────────────────────────────────────────────────────────\nfunction ghConfig() {\n  return {\n    owner : localStorage.getItem(LS_GH_OWNER) || '',\n    repo  : localStorage.getItem(LS_GH_REPO)  || '',\n    path  : localStorage.getItem(LS_GH_PATH)  || 'artifacts.json',\n    pat   : localStorage.getItem(LS_GH_PAT)   || '',\n  };\n}\n\nfunction ghIsConfigured() {\n  const c = ghConfig();\n  return c.owner && c.repo && c.pat;\n}\n\nfunction updateGhStatusUI() {\n  const configured = ghIsConfigured();\n  const dot  = document.getElementById('ghDot');\n  const text = document.getElementById('ghStatusText');\n  const pushBtn = document.getElementById('ghPushBtn');\n  const pullBtn = document.getElementById('ghPullBtn');\n  if (!dot) return;\n\n  if (configured) {\n    const c = ghConfig();\n    dot.className = 'gh-dot connected';\n    text.textContent = c.owner + '/' + c.repo;\n    pushBtn.style.display = 'inline-flex';\n    pullBtn.style.display = 'inline-flex';\n  } else {\n    dot.className = 'gh-dot';\n    text.textContent = 'Not configured';\n    pushBtn.style.display = 'none';\n    pullBtn.style.display = 'none';\n  }\n\n  const dotModal  = document.getElementById('ghDotModal');\n  const panelText = document.getElementById('ghStatusPanelText');\n  const timesRow  = document.getElementById('ghTimesRow');\n  if (!dotModal) return;\n\n  if (configured) {\n    const c = ghConfig();\n    dotModal.className = 'gh-dot connected';\n    panelText.textContent = 'Connected: ' + c.owner + '/' + c.repo + '/' + c.path;\n    const pushed = localStorage.getItem(LS_GH_PUSHED);\n    const pulled = localStorage.getItem(LS_GH_PULLED);\n    if (pushed || pulled) {\n      timesRow.style.display = 'flex';\n      document.getElementById('ghLastPushLabel').textContent = pushed ? 'Pushed: ' + fmtGhTime(pushed) : 'Never pushed';\n      document.getElementById('ghLastPullLabel').textContent = pulled ? 'Pulled: ' + fmtGhTime(pulled) : 'Never pulled';\n    } else {\n      timesRow.style.display = 'none';\n    }\n  } else {\n    dotModal.className = 'gh-dot';\n    panelText.textContent = 'Not configured — fill in the fields below.';\n    timesRow.style.display = 'none';\n  }\n}\n\nfunction fmtGhTime(iso) {\n  var d = new Date(iso);\n  return d.toLocaleString('en-GB', { day:'numeric', month:'short', hour:'2-digit', minute:'2-digit' });\n}\n\nfunction ghSetSyncing(syncing, error) {\n  const dot  = document.getElementById('ghDot');\n  const text = document.getElementById('ghStatusText');\n  if (!dot) return;\n  if (syncing) {\n    dot.className = 'gh-dot syncing';\n    text.textContent = 'Syncing...';\n  } else if (error) {\n    dot.className = 'gh-dot error';\n    text.textContent = error;\n  } else {\n    updateGhStatusUI();\n  }\n}\n\nasync function ghPush() {\n  if (!ghIsConfigured()) { openSettingsModal(); return; }\n  if (!ARTIFACTS.length) { showToast('Nothing to push — catalogue is empty'); return; }\n  const c = ghConfig();\n  ghSetSyncing(true);\n\n  try {\n    // Fetch current remote and merge first so push never shrinks catalogue\n    let sha = localStorage.getItem(LS_GH_SHA) || null;\n    const check = await fetch(\n      'https://api.github.com/repos/' + c.owner + '/' + c.repo + '/contents/' + c.path,\n      { headers: { 'Authorization': 'token ' + c.pat, 'Accept': 'application/vnd.github+json' } }\n    );\n    if (check.ok) {\n      const remote = await check.json();\n      sha = remote.sha;\n      localStorage.setItem(LS_GH_SHA, sha);\n      try {\n        const jsonStr = decodeURIComponent(escape(atob(remote.content.replace(/\\n/g,''))));\n        const payload = JSON.parse(jsonStr);\n        (payload.folders || []).forEach(function(f) {\n          if (!FOLDERS.find(function(x) { return x.id === f.id; })) FOLDERS.push(f);\n        });\n        (payload.artifacts || []).forEach(function(inc) {\n          const existing = ARTIFACTS.find(function(x) { return x.name === inc.name; });\n          if (!existing) {\n            const safeId = ARTIFACTS.length > 0 ? Math.max.apply(null, ARTIFACTS.map(function(a) { return a.id; })) + 1 : 1;\n            ARTIFACTS.push(Object.assign({}, inc, { id: safeId }));\n          } else {\n            const existingVTags = new Set(existing.versions.map(function(v) { return v.v; }));\n            (inc.versions || []).forEach(function(v) {\n              if (!existingVTags.has(v.v)) existing.versions.push(v);\n            });\n          }\n        });\n        lsSave();\n      } catch(mergeErr) {\n        console.warn('Pre-push merge failed, pushing as-is:', mergeErr);\n      }\n    }\n\n    const payload = { exportedAt: new Date().toISOString(), exportType: 'full', folders: FOLDERS, artifacts: ARTIFACTS };\n    const content = btoa(unescape(encodeURIComponent(JSON.stringify(payload, null, 2))));\n    const msgDate = new Date().toISOString().slice(0,16).replace('T',' ');\n\n    const body = { message: 'ArtyFarty sync ' + msgDate, content: content };\n    if (sha) body.sha = sha;\n\n    const res = await fetch(\n      'https://api.github.com/repos/' + c.owner + '/' + c.repo + '/contents/' + c.path,\n      {\n        method: 'PUT',\n        headers: { 'Authorization': 'token ' + c.pat, 'Accept': 'application/vnd.github+json', 'Content-Type': 'application/json' },\n        body: JSON.stringify(body)\n      }\n    );\n\n    if (!res.ok) {\n      const err = await res.json();\n      throw new Error(err.message || 'HTTP ' + res.status);\n    }\n\n    const result = await res.json();\n    const newSha = (result.content && result.content.sha) || (result.commit && result.commit.sha) || null;\n    if (newSha) localStorage.setItem(LS_GH_SHA, newSha);\n\n    const now = new Date().toISOString();\n    localStorage.setItem(LS_GH_PUSHED, now);\n    localStorage.setItem(LS_EXPORTED, now);\n    ghSetSyncing(false);\n    buildSidebar(); updateStats(); render();\n    showToast('Pushed ' + ARTIFACTS.length + ' artifacts to GitHub');\n\n  } catch(e) {\n    ghSetSyncing(false, 'Push failed');\n    showToast('Push failed: ' + e.message);\n    console.error('GitHub push error:', e);\n  }\n}\n\nasync function ghPull() {\n  if (!ghIsConfigured()) { openSettingsModal(); return; }\n  const c = ghConfig();\n  ghSetSyncing(true);\n\n  try {\n    const res = await fetch(\n      'https://api.github.com/repos/' + c.owner + '/' + c.repo + '/contents/' + c.path,\n      { headers: { 'Authorization': 'token ' + c.pat, 'Accept': 'application/vnd.github+json' } }\n    );\n\n    if (res.status === 404) {\n      ghSetSyncing(false);\n      showToast('File not found in repo — Push first to create it');\n      return;\n    }\n    if (!res.ok) {\n      const err = await res.json();\n      throw new Error(err.message || 'HTTP ' + res.status);\n    }\n\n    const data = await res.json();\n    localStorage.setItem(LS_GH_SHA, data.sha);\n    const jsonStr = decodeURIComponent(escape(atob(data.content.replace(/\\n/g,''))));\n    const payload = JSON.parse(jsonStr);\n\n    if (ARTIFACTS.length > 0) {\n      mergeData(payload);\n    } else {\n      initData(payload);\n    }\n\n    localStorage.setItem(LS_GH_PULLED, new Date().toISOString());\n    ghSetSyncing(false);\n    showToast('Pulled from GitHub');\n\n  } catch(e) {\n    ghSetSyncing(false, 'Pull failed');\n    showToast('Pull failed: ' + e.message);\n    console.error('GitHub pull error:', e);\n  }\n}\n\nfunction openSettingsModal() {\n  const c = ghConfig();\n  document.getElementById('gh-owner').value = c.owner || 'philliprichards26';\n  document.getElementById('gh-repo').value  = c.repo  || 'artyfarty';\n  document.getElementById('gh-path').value  = c.path  || 'artifacts.json';\n  document.getElementById('gh-pat').value   = c.pat;\n  updateGhStatusUI();\n  document.getElementById('settingsModal').classList.add('show');\n}\n\nfunction closeSettingsModal() {\n  document.getElementById('settingsModal').classList.remove('show');\n}\n\nfunction saveGhSettings() {\n  const owner = document.getElementById('gh-owner').value.trim();\n  const repo  = document.getElementById('gh-repo').value.trim();\n  const path  = document.getElementById('gh-path').value.trim() || 'artifacts.json';\n  const pat   = document.getElementById('gh-pat').value.trim();\n\n  if (!owner || !repo || !pat) { showToast('Username, repo, and PAT are required'); return; }\n\n  localStorage.setItem(LS_GH_OWNER, owner);\n  localStorage.setItem(LS_GH_REPO,  repo);\n  localStorage.setItem(LS_GH_PATH,  path);\n  localStorage.setItem(LS_GH_PAT,   pat);\n  localStorage.removeItem(LS_GH_SHA);\n\n  closeSettingsModal();\n  updateGhStatusUI();\n  showToast('GitHub connected: ' + owner + '/' + repo);\n}\n\nfunction clearGhSettings() {\n  if (!confirm('Disconnect GitHub sync? Local catalogue unaffected.')) return;\n  [LS_GH_OWNER, LS_GH_REPO, LS_GH_PATH, LS_GH_PAT, LS_GH_SHA, LS_GH_PUSHED, LS_GH_PULLED].forEach(function(k) {\n    localStorage.removeItem(k);\n  });\n  closeSettingsModal();\n  updateGhStatusUI();\n  showToast('GitHub disconnected');\n}\n\nasync function ghAutoPullOnLoad() {\n  if (!ghIsConfigured()) return;\n  const c = ghConfig();\n  try {\n    const res = await fetch(\n      'https://api.github.com/repos/' + c.owner + '/' + c.repo + '/contents/' + c.path,\n      { headers: { 'Authorization': 'token ' + c.pat, 'Accept': 'application/vnd.github+json' } }\n    );\n    if (!res.ok) return;\n    const data = await res.json();\n    const knownSha = localStorage.getItem(LS_GH_SHA);\n    if (knownSha && knownSha === data.sha) { showToast('GitHub: catalogue up to date'); return; }\n    localStorage.setItem(LS_GH_SHA, data.sha);\n    const jsonStr = decodeURIComponent(escape(atob(data.content.replace(/\\n/g,''))));\n    const payload = JSON.parse(jsonStr);\n    mergeData(payload);\n    localStorage.setItem(LS_GH_PULLED, new Date().toISOString());\n    showToast('Auto-pulled updates from GitHub');\n  } catch(e) {\n    console.warn('GitHub auto-pull failed:', e);\n  }\n}\n</script>\n</body>\n</html>\n"
      }
